{
  "mcpServers": {
    "pecot-visual": {
      "command": "npx",
      "args": [
        "--prefix=${CLAUDE_PLUGIN_DATA}",
        "-y",
        "@pecot/visual-mcp@4.0.1"
      ]
    },
    "pecot-visual-playwright": {
      "command": "npx",
      "args": [
        "--prefix=${CLAUDE_PLUGIN_DATA}",
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--no-sandbox"
      ]
    }
  }
}
