{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "pecot-visual": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--prefix=${PLUGIN_DATA}",
        "-y",
        "@pecot/visual-mcp@4.0.0"
      ]
    },
    "pecot-visual-playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--prefix=${PLUGIN_DATA}",
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--no-sandbox"
      ]
    }
  }
}
