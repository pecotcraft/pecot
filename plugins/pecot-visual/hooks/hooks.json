{
  "description": "pecot-visual plugin hooks: calls the pecot-visual MCP tools that lint written or edited files, initializes .pecotv and syncs README/CHANGELOG when pecotv use is detected, and notifies at SessionStart about tracking .pecotv/.gitignore in existing repos",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/user-prompt-submit.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/pre-tool-use-skill.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:pecot-v:pecot-visual",
            "tool": "file_lint",
            "input": {
              "file_path": "${tool_input.file_path}",
              "cwd": "${cwd}"
            },
            "timeout": 80
          },
          {
            "type": "mcp_tool",
            "server": "plugin:pecot-v:pecot-visual",
            "tool": "file_validate",
            "input": {
              "file_path": "${tool_input.file_path}",
              "cwd": "${cwd}"
            },
            "timeout": 80
          },
          {
            "type": "mcp_tool",
            "server": "plugin:pecot-v:pecot-visual",
            "tool": "file_brief",
            "input": {
              "file_path": "${tool_input.file_path}",
              "cwd": "${cwd}"
            },
            "timeout": 80
          }
        ]
      }
    ]
  }
}
