{
  "name": "@pecot/pecotv-cli",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "//slidev-parser-pin-reason": "@slidev/parser は @slidev/cli が引き込む版と同じに固定する。pptx 差分キャッシュの slideHash がずれるため。",
  "type": "module",
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "scripts": {
    "prebuild": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "node scripts/tsc.mjs -p tsconfig.build.json",
    "postbuild": "node --eval \"require('node:fs').writeFileSync('dist/package.json', JSON.stringify({type:'module'}))\"",
    "lint": "node scripts/tsc.mjs --noEmit && eslint --max-warnings=0 . && knip",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@pecot/text-rules": "workspace:@pecot/text-rules-src@*",
    "@modelcontextprotocol/server": "^2.4.0",
    "@slidev/cli": "^53.1.0",
    "@slidev/parser": "53.1.0",
    "@xmldom/xmldom": "^0.9.12",
    "commander": "^15.1.0",
    "dom-to-pptx": "2.1.2",
    "mime-types": "^2.1.35",
    "playwright": "^1.64.1",
    "xpath": "^0.0.36",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "knip": {
    "project": [
      "src/**/*.ts",
      "tests/**/*.ts"
    ],
    "ignoreBinaries": [
      "flock",
      "strace",
      "fc-list",
      "pdftotext",
      "pdffonts",
      "pdftoppm"
    ],
    "ignoreDependencies": [
      "dom-to-pptx",
      "@slidev/cli",
      "typescript7"
    ],
    "ignoreExportsUsedInFile": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jsdom": "^28.0.3",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^25.9.9",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^31.0.0",
    "knip": "^6.44.2",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "nx": {
    "root": "plugins/pecot-visual",
    "name": "pecot-visual",
    "includedScripts": []
  }
}
