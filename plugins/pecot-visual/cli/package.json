{
  "name": "@pecot/pecotv-cli",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "//pin-reason": "nx-release は CLI runtime の解決を切り替えたため、bump 不要。解決先は CLAUDE_PLUGIN_ROOT と、import.meta.url 相対の plugin.json の直読み。0.0.0 pin は意図的な設計（PR #741）。",
  "//slidev-parser-pin-reason": "@slidev/parser は完全固定。@slidev/cli が引き込む parser と別バージョンを使うと、slides.md の分解結果（= pptx 差分キャッシュの slideHash）がビルド時の結果と食い違う。hoisted linker で実体が分かれ得る ^ 指定は使わない。@slidev/cli を更新するときは、本項も同じバージョンへ上げる。",
  "//tsc7-path-reason": "typescript7（npm:typescript@7 alias）は、pnpm の hoisted linker で workspace root にだけ hoist される。置き場所は plugins/pecot-visual/node_modules/ になる。そのため cli からは ../node_modules/typescript7/bin/tsc を明示パスで起動する。tsc bin 名の解決はパッケージマネージャの実装に依存し、結果が一定でない。そのため .bin/tsc 経由には簡略化しない。",
  "type": "module",
  "engines": {
    "node": "^24.22.1 || >=26.12.1",
    "npm": "<0.0.0",
    "yarn": "<0.0.0"
  },
  "scripts": {
    "prebuild": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "node ../node_modules/typescript7/bin/tsc -p tsconfig.build.json",
    "postbuild": "node --eval \"require('node:fs').writeFileSync('dist/package.json', JSON.stringify({type:'module'}))\"",
    "lint": "node ../node_modules/typescript7/bin/tsc --noEmit && eslint --max-warnings=0 . && knip",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@pecot/text-rules": "workspace:@pecot/text-rules-src@*",
    "@modelcontextprotocol/server": "^2.4.0",
    "@slidev/cli": "^53.0.0",
    "@slidev/parser": "53.0.0",
    "@xmldom/xmldom": "^0.9.12",
    "commander": "^15.0.0",
    "dom-to-pptx": "2.1.1",
    "mime-types": "^3.0.2",
    "playwright": "^1.64.1",
    "xpath": "^0.0.34",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "knip": {
    "project": [
      "src/**/*.ts",
      "tests/**/*.ts"
    ],
    "ignoreBinaries": [
      "flock",
      "strace",
      "fc-list",
      "pdftotext",
      "pdffonts",
      "pdftoppm"
    ],
    "ignoreDependencies": [
      "dom-to-pptx",
      "@slidev/cli"
    ],
    "ignoreExportsUsedInFile": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jsdom": "^28.0.3",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.9.9",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.1.1",
    "knip": "^6.42.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
