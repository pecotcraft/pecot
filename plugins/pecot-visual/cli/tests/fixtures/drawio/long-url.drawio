        <mxCell id="legLowLabel" value="Challenging" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=sans-serif;fontSize=12;fontColor=#333333;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="512" y="588" width="80" height="20" as="geometry" /></mxCell>
        <!-- URL 長の水増し用。圧縮されにくい決定的な 16 進文字列（tooltip に置き、8,000 文字超を保つ） -->
        <object id="urlPadding" label="" tooltip=""><mxCell style="rounded=0;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="20" height="20" as="geometry" /></mxCell></object>
