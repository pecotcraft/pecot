{
  "name": "@pecot/slidev-runtime",
  "version": "0.0.0",
  "description": "pecot-visual 本体の実行時依存。talk-dir が張る依存ルートと単体配布の install の根拠になる。",
  "type": "module",
  "private": true,
  "license": "MIT",
  "//peer-reason": "peer は slidev-theme-* の peerDependencies と同じ版に固定する。@slidev/* は @slidev/cli と同じ版にする。",
  "//override-reason": "overrides は root の pnpm-workspace.yaml の写し。lodash-es は overrides に置くと EOVERRIDE になる。",
  "dependencies": {
    "@shikijs/langs": "4.6.0",
    "@shikijs/themes": "4.6.0",
    "@slidev/cli": "53.1.0",
    "@slidev/client": "53.1.0",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/types": "53.1.0",
    "@vueuse/core": "15.0.0",
    "dayjs": "1.11.23",
    "html2canvas": "1.4.1",
    "lodash-es": "4.18.1",
    "shiki": "4.6.0",
    "uuid": "13.0.2",
    "vite": "^8.3.6",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "dom-to-pptx": "2.1.2"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "puppeteer": "npm:puppeteer-core@25.16.0",
    "image-size": "^2.0.3"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "nx": {
    "root": "plugins/pecot-visual",
    "name": "pecot-visual",
    "includedScripts": []
  }
}
