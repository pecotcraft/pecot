{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "rootDir": ".",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noEmitOnError": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["**/*.test.ts"],
  "exclude": ["node_modules", "**/dist/**"]
}
