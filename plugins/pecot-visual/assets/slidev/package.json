{
  "name": "@pecot/slidev-assets-dev",
  "version": "0.0.0",
  "description": "Slidev アセットの lint/test 環境（lint 規則と lint の補助スクリプトの品質保証）",
  "type": "module",
  "private": true,
  "license": "MIT",
  "//tsc7-path-reason": "typescript7（npm:typescript@7 alias）は、pnpm の hoisted linker の挙動により hoist される。hoist 先は workspace root（plugins/pecot-visual/node_modules/）だけになる。そのため assets/slidev からは、../../node_modules/typescript7/bin/tsc を明示パスで起動する。tsc bin 名の解決は、パッケージマネージャの実装に依存して非決定的になる。そのため、.bin/tsc 経由には簡略化しない。",
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "scripts": {
    "lint": "eslint --no-cache --max-warnings 0 scripts && node scripts/design-lint/lint-design.mjs",
    "lint:design": "node scripts/design-lint/lint-design.mjs",
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "build:test": "node ../../node_modules/typescript7/bin/tsc -b --force tsconfig.test.json",
    "prelint": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:coverage": "c8 node scripts/test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@google/design.md": "0.4.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "c8": "^10.1.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jszip": "^3.10.2",
    "playwright": "^1.64.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vue-eslint-parser": "^10.4.1",
    "yaml": "^2.9.1"
  }
}
