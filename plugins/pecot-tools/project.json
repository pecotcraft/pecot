{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "pecot-tools",
  "projectType": "library",
  "tags": ["type:plugin", "scope:p-t"],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [{ "projects": ["pecot"], "target": "install" }],
      "metadata": {
        "description": "リポジトリ全体の依存導入は、root の project の install が 1 回の nx 実行につき 1 回だけ行う (#1080, #113)。各レーンはこの install を dependsOn で参照する。nx の task graph は、同じ project:target を 1 タスクにまとめる。そのため、実行するレーンが何本あっても、導入は 1 回になる。本ターゲットは pnpm を打たず、導入の後に scripts の package manager 自己呼び出しガード (#1217) を確かめる。cache: false は明示的な宣言。ガードは node_modules の状態に依らないが、cache を付けると、確認が 0 回になる。"
      },
      "options": {
        "command": "bash scripts/ci/check-pm-scripts.sh",
        "cwd": "plugins/pecot-tools"
      }
    },
    "build-cli": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/cli/**/*",
        "!{projectRoot}/cli/**/*.md",
        "!{projectRoot}/cli/**/tests/**/*",
        "!{projectRoot}/cli/**/*.test.*",
        "!{projectRoot}/cli/dist/**/*",
        "sharedGlobals"
      ],
      "options": {
        "command": "pnpm --filter @pecot/pecot-tools-cli run build",
        "cwd": "plugins/pecot-tools"
      }
    },
    "test": {
      "executor": "nx:noop",
      "cache": false,
      "dependsOn": ["test-cli", "test-release"],
      "metadata": {
        "description": "CI と manual の stage の nx-affected-tests が起動する起点の target。レーン（test-*）はそれぞれの inputs でキャッシュされ、入力の変わったレーンだけが実行される。"
      }
    },
    "test-cli": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/test-layers.txt",
        "{workspaceRoot}/libs/interface-spec/src/vitest/unique-titles.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/allure-reporter.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/report-labels.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/attach.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/explains.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/verifies.ts",
        "{projectRoot}/cli/**/*",
        "{projectRoot}/interface/**/*",
        "{workspaceRoot}/libs/interface-spec/src/domain/diff.ts",
        "{workspaceRoot}/libs/interface-spec/src/domain/schema.ts",
        "{workspaceRoot}/libs/interface-spec/src/domain/utility.ts",
        "{workspaceRoot}/libs/interface-spec/package.json",
        "sharedGlobals",
        "pecotToolsPluginTestGlobals",
        "{workspaceRoot}/.githooks/pre-commit/check-engines-node-drift.sh"
      ],
      "dependsOn": ["install", "build-cli"],
      "outputs": ["{projectRoot}/cli/test-results/junit.xml", "{projectRoot}/test-results/test-cli/allure-results"],
      "metadata": {
        "description": "install と cli/dist の build は、dependsOn 経由で実行ごとに 1 回だけ実行する (#1080)。run-tests.sh には PECOT_TOOLS_SKIP_INSTALL=1 を渡し、同じ処理の二重実行を止める。plugin.json、.mcp.json、mcp.json などの登録ファイルは、pecotToolsPluginTestGlobals が全レーンに引く。"
      },
      "options": {
        "command": "rm -rf test-results/test-cli/allure-results && PECOT_TOOLS_SKIP_INSTALL=1 bash scripts/ci/run-tests.sh --scope=cli",
        "cwd": "plugins/pecot-tools"
      }
    },
    "test-release": {
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/.githooks/test-layers.txt",
        "{projectRoot}/test-layers.txt",
        "{workspaceRoot}/.githooks/scripts/test_report/bash-test.sh",
        "{workspaceRoot}/.githooks/scripts/test_report/allure-result.sh",
        "{projectRoot}/scripts/release/**/*",
        "{workspaceRoot}/LICENSE",
        "{workspaceRoot}/.githooks/lib/mcp-publish-common.sh",
        "{workspaceRoot}/.githooks/scripts/attach-mcp-tgz.sh",
        "{workspaceRoot}/.githooks/scripts/origin-slug.mjs",
        "{workspaceRoot}/.githooks/scripts/tests/attach-mcp-tgz.test.sh",
        "{workspaceRoot}/.githooks/scripts/tests/mcp-publish-common.test.sh",
        "sharedGlobals",
        "pecotToolsPluginTestGlobals"
      ],
      "dependsOn": ["install", "build-cli"],
      "//command-reason": "PECOT_RELEASE_TEST_NPM_CACHE は絶対パスで渡すため、cwd からの $PWD で組む (#1225)。",
      "outputs": ["{projectRoot}/test-results/test-release/allure-results"],
      "metadata": {
        "description": "MCP 単体配布の publish スクリプトの確認。cache: true (#1225)。publish のテストは npm の依存解決で外部レジストリの状態を読み、その状態は入力ハッシュに表せない。それでもキャッシュするのは、cli/src の 1 行修正のたびに本レーンを実行しないため。レジストリ側の変化は、リリース時の dry-run と監査で拾う。依存解決の npm キャッシュは PECOT_RELEASE_TEST_NPM_CACHE で永続化する。掃除は .pecot/tmp/release-npm-cache/pecot-tools を消す。本レーンの publish は --skip-build で共有の cli/dist を複製するだけなので、test-cli と並行して動いても dist を奪い合わない (#1235)。"
      },
      "options": {
        "command": "rm -rf test-results/test-release/allure-results && PECOT_TOOLS_SKIP_INSTALL=1 PECOT_RELEASE_TEST_NPM_CACHE=\"$PWD/../../.pecot/tmp/release-npm-cache/pecot-tools\" bash scripts/ci/run-tests.sh --scope=release",
        "cwd": "plugins/pecot-tools"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/cli/**/*",
        "{workspaceRoot}/libs/interface-spec/src/domain/diff.ts",
        "{workspaceRoot}/libs/interface-spec/src/domain/schema.ts",
        "{workspaceRoot}/libs/interface-spec/src/domain/utility.ts",
        "{workspaceRoot}/libs/interface-spec/package.json",
        "sharedGlobals",
        "pecotToolsPluginLintGlobals",
        "{workspaceRoot}/libs/interface-spec/src/eslint/describe-title.ts",
        "{workspaceRoot}/libs/interface-spec/src/eslint/table-key.ts",
        "{workspaceRoot}/libs/interface-spec/src/eslint/test-description.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/allure-reporter.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/report-labels.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/attach.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/explains.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/verifies.ts",
        "{projectRoot}/interface/generated.json"
      ],
      "options": {
        "command": "bash scripts/ci/run-lint.sh --scope=cli",
        "cwd": "plugins/pecot-tools"
      }
    },
    "nx-release-publish": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "nx release の publish phase から MCP サーバの tgz を作って Release に添え、publish-npm.yml を起動する (#1056)。スクリプト側が HEAD の pecot-tools-v<version> タグで冪等性を判定し、pecot-tools 非リリース時は何もせず終了する。"
      },
      "options": {
        "//forwardAllArgs-reason": "既定 true だと --dryRun=true が末尾に注入される。dry-run は NX_DRY_RUN で受ける (#1056)。",
        "forwardAllArgs": false,
        "command": "bash scripts/release/publish-mcp-dist.sh",
        "cwd": "plugins/pecot-tools"
      }
    }
  },
  "release": {
    "version": {
      "versionActions": "./.nx/nx-release/src/version-actions.js",
      "manifestRootsToUpdate": [
        { "path": "{projectRoot}/.claude-plugin" },
        { "path": "{projectRoot}" }
      ]
    }
  }
}
