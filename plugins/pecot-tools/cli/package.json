{
  "name": "@pecot/pecot-tools-cli",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "pecot-tools-mcp": "dist/main.js"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "scripts": {
    "prebuild": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "node scripts/tsc.mjs -p tsconfig.build.json",
    "postbuild": "node --eval \"require('node:fs').writeFileSync('dist/package.json', JSON.stringify({type:'module'}))\"",
    "lint": "node scripts/tsc.mjs --noEmit && eslint --max-warnings=0 . && knip",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "knip": {
    "project": [
      "src/**/*.ts",
      "tests/**/*.ts",
      "scripts/**/*.ts"
    ],
    "ignoreDependencies": [
      "typescript7"
    ],
    "ignoreExportsUsedInFile": true,
    "rules": {
      "catalogReferences": "off"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.11",
    "@vitest/coverage-v8": "^5.1.2",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-n": "^18.6.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "^6.48.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.74.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "catalog:",
    "vitest": "^5.1.2",
    "yaml": "^2.9.1"
  },
  "nx": {
    "root": "plugins/pecot-tools",
    "name": "pecot-tools",
    "includedScripts": []
  }
}
