#!/usr/bin/env bash
# pecot CLI wrapper — プラグインのデータ置き場に作る実行用ミラーの Node ランタイムを起動する。
#
# 依存（node_modules）と build 成果物は、プラグイン本体（CLAUDE_PLUGIN_ROOT）ではなく
# `${データ置き場}/runtime/<deps-hash>-<src-hash>/` に作る。ハッシュが同じなら何もせず、
# ソースだけ変わったときは build だけ、依存が変わったときだけ install する。
#
#   1. SKIP（開発・ゲート専用）: 本体ツリーの成果物を直接実行する。データ置き場は使わない
#   2. データ置き場を解決して作る（CLAUDE_PLUGIN_DATA → PLUGIN_DATA → 既定の場所。bin/_lib.sh の plugin_data_dir_ensure）
#   3. ミラーを用意する（bin/_lib.sh の plugin_runtime_ensure）。使用中は `.inuse` の共有ロックで示す
#   4. 旧方式の venv（${DATA}/venv と既定の場所の venv）を、使用中でないものから片づける
#   5. ミラーの cli を exec する
set -euo pipefail

# PLUGIN_ROOT を解決
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "${CLAUDE_PLUGIN_ROOT}/.claude-plugin/plugin.json" ]; then
  PLUGIN_ROOT="$CLAUDE_PLUGIN_ROOT"
else
  SELF="$(realpath "$0")"
  PLUGIN_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
fi
# cli は plugin.json・cli/templates/・interface/・hooks/ を、この値から本体で読む（ミラーには入らない）。
export CLAUDE_PLUGIN_ROOT="$PLUGIN_ROOT"

# source path は symlink 経由起動でも壊れないよう PLUGIN_ROOT 基準で解決する。
# shellcheck source=./_lib.sh
. "$PLUGIN_ROOT/bin/_lib.sh"

# 1. SKIP: 本体ツリーの成果物を直接実行する（開発・ゲート専用）。
if [ "${PECOT_BOOTSTRAP_SKIP:-}" = "1" ]; then
  CLI_DIST="${PLUGIN_ROOT}/cli-node/dist/cli.js"
  if [ ! -f "$CLI_DIST" ]; then
    echo "error: ${CLI_DIST} is missing. Build first (PECOT_BOOTSTRAP_SKIP=1 runs the source tree directly)" >&2
    exit 1
  fi
  exec node "$CLI_DIST" "$@"
fi

# 2. データ置き場。解決順は CLAUDE_PLUGIN_DATA → PLUGIN_DATA → 既定の場所（本体配下には何も作らない）。
DATA="$(plugin_data_dir_ensure pecot-workflow)" || exit 1
RUNTIME_BASE="$DATA/runtime"
PLUGIN_RUNTIME_FORCE="${PECOT_BOOTSTRAP_FORCE:-}"

# bootstrap 中の stdout を丸ごと stderr へ寄せ、stdin を /dev/null に差し替える。
# `pecot mcp` は stdout を JSON-RPC チャネルとして専有し、stdin は JSON-RPC の入力パイプになる。
# 本リダイレクトはブロック内に閉じるため、後段の `exec node` には影響しない。
{
  # 3. ミラーを用意し、使用中を示す共有ロックを取る。取った後に完成印が消えていたら（世代削除と
  # 行き違った）、作り直しへ戻る。fd 6 は開いたまま `exec node` に継承される。
  attempt=0
  while :; do
    plugin_runtime_ensure "$PLUGIN_ROOT" "$RUNTIME_BASE" || exit $?
    RUNTIME_DIR="$PLUGIN_RUNTIME_DIR"
    if { : >> "$RUNTIME_DIR/.inuse" && exec 6<"$RUNTIME_DIR/.inuse"; } 2>/dev/null; then
      if command -v flock >/dev/null 2>&1; then flock -s 6; fi
      if plugin_runtime_is_complete "$RUNTIME_DIR"; then break; fi
      exec 6<&-
    fi
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 3 ]; then
      pecot_log "error: could not prepare the runtime mirror: ${RUNTIME_DIR}"
      exit 1
    fi
  done
  # 4. 旧方式の venv。毎回 venv の有無を見て、あるときだけ片づける。
  plugin_legacy_venv_cleanup "$DATA" || true
} >&2 </dev/null

# 5. ミラーの cli を実行する。
exec node "$RUNTIME_DIR/cli-node/dist/cli.js" "$@"
