{
  "mcpServers": {
    "pecot-workflow": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/pecot",
      "args": [
        "mcp"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp/oauth"
    },
    "pecot-workflow-playwright": {
      "command": "npx",
      "args": [
        "--prefix=${CLAUDE_PLUGIN_ROOT}/bin",
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--no-sandbox"
      ]
    }
  }
}
