{
  "format": 1,
  "plugin": "pecot-workflow",
  "prefix": "PW",
  "entries": [
    {
      "id": "PW-ADD-TO-PROJECT",
      "name": "add-to-project",
      "description": "Add an Issue to the project board with a GraphQL mutation (for an Issue created outside pecot)",
      "surfaces": {
        "cli": {
          "path": [
            "add-to-project"
          ]
        }
      },
      "hidden": false,
      "deprecated": false,
      "input": {
        "type": "object",
        "properties": {
          "issue_ref": {
            "type": "string",
            "description": "Issue reference (`owner/repo/N`, or the short form `N` only with `--repo`)"
          },
          "status": {
            "type": "string",
            "default": "ready",
            "description": "Initial status (backlog/pending/ready/active/in_review/archived)"
          }
        },
        "required": [
          "issue_ref"
        ],
        "additionalProperties": false
      },
      "cli": {
        "positional": [
          "issue_ref"
        ],
        "flags": {
          "status": [
            "--status",
            "-s"
          ]
        }
      }
    },
    {
      "id": "PW-CREATE-BRANCH",
      "name": "create-branch",
      "description": "Create a branch linked to an Issue (shown in the Development section of the Issue)",
      "surfaces": {
        "cli": {
          "path": [
            "create-branch"
          ]
        }
      },
      "hidden": false,
      "deprecated": false,
      "input": {
        "type": "object",
        "properties": {
          "allow_cross_repo": {
            "type": "boolean",
            "default": false,
            "description": "Allow the CWD repository to differ from the Issue ref (for scripts and runs outside the CWD)"
          },
          "base": {
            "type": "string",
            "description": "Base branch (default: develop_branch from the config)"
          },
          "branch_name": {
            "type": "string",
            "description": "Name of the branch to create"
          },
          "checkout": {
            "type": "boolean",
            "default": true,
            "description": "Kept for compatibility; has no effect"
          },
          "force_overwrite_active": {
            "type": "boolean",
            "default": false,
            "description": "Disable the .pecot-active overwrite guard (when sure it is stale)"
          },
          "issue_ref": {
            "type": "string",
            "description": "Issue reference (owner/repo/123)"
          }
        },
        "required": [
          "branch_name",
          "issue_ref"
        ],
        "additionalProperties": false
      },
      "cli": {
        "positional": [
          "issue_ref",
          "branch_name"
        ],
        "flags": {
          "allow_cross_repo": [
            "--allow-cross-repo",
            "-X"
          ],
          "base": [
            "--base",
            "-b"
          ],
          "checkout": [
            "--checkout",
            "--no-checkout"
          ],
          "force_overwrite_active": [
            "--force-overwrite-active",
            "-F"
          ]
        }
      }
    },
    {
      "id": "PW-DELETE-BRANCH",
      "name": "delete-branch",
      "description": "Delete a remote branch (a protected branch is never deleted)",
      "surfaces": {
        "cli": {
          "path": [
            "delete-branch"
          ]
        }
      },
      "hidden": false,
      "deprecated": false,
      "input": {
        "type": "object",
        "properties": {
          "branch": {
            "type": "string",
            "description": "Name of the branch to delete"
          },
          "dry_run": {
            "type": "boolean",
            "default": false,
            "description": "Show what would be deleted without deleting anything"
          },
          "repo_ref": {
            "type": "string",
            "description": "Repository reference (owner/repo)"
          }
        },
        "required": [
          "branch",
          "repo_ref"
        ],
        "additionalProperties": false
      },
      "cli": {
        "positional": [
          "repo_ref",
          "branch"
        ],
        "flags": {
          "dry_run": [
            "--dry-run",
            "-n"
          ]
        }
      }
    },
    {
      "id": "PW-DEPENDABOT-SYNC",
      "name": "dependabot sync",
      "description": "Rewrite the open Tracker's list of Dependabot PRs waiting for a human decision",
      "surfaces": {
        "cli": {
          "path": [
            "dependabot",
            "sync"
          ]
        }
      },
      "hidden": false,
      "deprecated": false,
      "input": {
        "type": "object",
        "properties": {
          "dry_run": {
            "type": "boolean",
            "default": false,
            "description": "Show the planned Tracker changes without changing anything"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "cli": {
        "positional": [],
        "flags": {
          "dry_run": [
            "--dry-run"
          ]
        }
      }
    },
    {
      "id": "PW-ISSUE-COMMENT",
      "name": "issue comment",
      "description": "Post a comment on an Issue",
      "surfaces": {
        "cli": {
          "path": [
            "issue",
            "comment"
          ]
        }
      },
      "hidden": false,
      "deprecated": false,
      "input": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "description": "Path of a Markdown file with frontmatter"
          },
          "issue": {
            "type": "string",
            "description": "Issue reference (owner/repo/123 form, required with -m)"
          },
          "message": {
            "type": "string",
            "description": "Comment body"
          },
          "prepare": {
            "type": "boolean",
            "default": false,
            "description": "Copy a template to the work directory"
          },
          "template": {
            "type": "string",
            "enum": [
              "plan",
              "merge-diff",
              "review-findings",
              "review-resolution",
              "precede-notify"
            ],
            "description": "Template type (required with --prepare and -m; plan/merge-diff/review-findings/review-resolution/precede-notify)"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "cli": {
        "positional": [
          "file"
        ],
        "flags": {
          "issue": [
            "--issue",
            "-i"
          ],
          "message": [
            "--message",
            "-m"
          ],
          "prepare": [
            "--prepare",
            "-p"
          ],
          "template": [
            "--template",
            "-t"
          ]
        }
      }
    },
    {
      "id": "PW-ISSUE-CREATE",
      "name": "issue create",
      "description": "Create Issues from Markdown files with frontmatter",
      "surfaces": {
        "cli": {
          "path": [
            "issue",
            "create"
          ]
        }
      },
      "hidden": false,
      "deprecated": false,
      "input": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Path of a Markdown file with frontmatter (several for a batch post)"
          },
          "label": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Label (can be given several times)"
          },
          "message": {
            "type": "string",
            "description": "Issue body (direct posting mode)"
          },
          "order": {
            "type": "integer",
            "description": "Order number of the subtask (used with parent_epic)"
          },
          "parent_epic": {
            "type": "string",
            "description": "Parent Epic reference: an integer (relative to aggregation_repo) or the primary form 'owner/repo/N'"
          },
          "prepare": {
            "type": "boolean",
            "default": false,
            "description": "Copy a template to the work directory"
          },
          "priority": {
            "type": "string",
            "description": "Priority (high/medium/low)"
          },
          "repo": {
            "type": "string",
            "description": "Repository (owner/repo form; required with -m / --prepare unless epic)"
          },
          "size": {
            "type": "string",
            "description": "Size (xs/s/m/l)"
          },
          "status": {
            "type": "string",
            "description": "Status (backlog/pending/ready/active/in_review/archived)"
          },
          "suffix": {
            "type": "string",
            "description": "Suffix of the output file name (only with --prepare)"
          },
          "template": {
            "type": "string",
            "enum": [
              "task",
              "bug",
              "epic",
              "tracker",
              "task-implement"
            ],
            "default": "task",
            "description": "Template type (with --prepare: task/bug/epic/tracker/task-implement)"
          },
          "title": {
            "type": "string",
            "description": "Issue title (direct posting mode, required with -m)"
          },
          "type": {
            "type": "string",
            "enum": [
              "task",
              "bug",
              "epic",
              "tracker"
            ],
            "default": "task",
            "description": "Issue type (task/bug/epic/tracker)"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "cli": {
        "positional": [
          "files"
        ],
        "flags": {
          "label": [
            "--label",
            "-l"
          ],
          "message": [
            "--message",
            "-m"
          ],
          "order": [
            "--order"
          ],
          "parent_epic": [
            "--parent-epic"
          ],
          "prepare": [
            "--prepare",
            "-p"
          ],
          "priority": [
            "--priority"
          ],
          "repo": [
            "--repo",
            "-r"
          ],
          "size": [
            "--size"
          ],
          "status": [
            "--status"
          ],
          "suffix": [
            "--suffix",
            "-s"
          ],
          "template": [
            "--template"
          ],
          "title": [
            "--title",
            "-t"
          ],
          "type": [
            "--type"
          ]
        }
      }
    },
