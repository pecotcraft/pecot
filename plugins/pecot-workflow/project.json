{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "pecot-workflow",
  "projectType": "library",
  "tags": ["type:plugin", "scope:p-w"],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [{ "projects": ["pecot"], "target": "install" }],
      "metadata": {
        "description": "リポジトリ全体の依存導入は、root の project の install が 1 回の nx 実行につき 1 回だけ行う (#1080, #113)。各レーンはこの install を dependsOn で参照する。nx の task graph は、同じ project:target を 1 タスクにまとめる。そのため、実行するレーンが何本あっても、導入は 1 回になる。本ターゲットは pnpm を打たず、導入の後に scripts の package manager 自己呼び出しガード (#1217) を確かめる。cache: false は明示的な宣言。ガードは node_modules の状態に依らないが、cache を付けると、確認が 0 回になる。"
      },
      "options": {
        "command": "bash scripts/ci/check-pm-scripts.sh",
        "cwd": "plugins/pecot-workflow"
      }
    },
    "build-cli": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/cli/**/*",
        "!{projectRoot}/cli/**/*.md",
        "!{projectRoot}/cli/**/tests/**/*",
        "!{projectRoot}/cli/**/*.test.*",
        "!{projectRoot}/cli/dist/**/*",
        "sharedGlobals",
        "^production"
      ],
      "dependsOn": ["install", { "projects": ["workflow-core"], "target": "build" }],
      "metadata": {
        "description": "cli の tsc が @pecot/workflow-core を libs/workflow-core/dist から読むため、workflow-core:build を待つ。libs/workflow-core の変更は、project graph の依存先として ^production が取り込む。"
      },
      "options": {
        "command": "pnpm --filter @pecot/pecot-workflow-cli run build",
        "cwd": "plugins/pecot-workflow"
      }
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": ["test-cli", "test-bootstrap", "test-hooks", "test-skills", "test-release"],
      "metadata": {
        "description": "CI と manual の stage の nx-affected-tests が起動する起点。レーン（test-*）はそれぞれの inputs でキャッシュされ、入力の変わったレーンだけが実行される。"
      }
    },
    "test-cli": {
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/libs/interface-spec/src/vitest/unique-titles.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/allure-reporter.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/attach.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/verifies.ts",
        "{projectRoot}/cli/**/*",
        "{projectRoot}/skills/w-help/references/board-sync-workflow.md",
        "!{projectRoot}/cli/tests/hooks/**",
        "!{projectRoot}/cli/tests/bootstrap/**",
        "!{projectRoot}/cli/tests/skills/**",
        "sharedGlobals",
        "runtime",
        { "runtime": "git --version" },
        "env",
        "pecotPluginEnv",
        "pecotPluginNodeInputs",
        "{projectRoot}/.claude-plugin/plugin.json",
        "{projectRoot}/scripts/ci/run-tests.sh",
        "{projectRoot}/cli/templates/**/*",
        "{projectRoot}/interface/generated.json",
        "{projectRoot}/interface/authored.yaml",
        "{projectRoot}/interface/github-issue-surface.json",
        "{projectRoot}/interface/issue-coverage.yaml",
        "{workspaceRoot}/libs/interface-spec/src/domain/diff.ts",
        "{workspaceRoot}/libs/interface-spec/src/domain/schema.ts",
        "{workspaceRoot}/libs/interface-spec/src/domain/utility.ts",
        "{workspaceRoot}/libs/interface-spec/package.json",
        "{projectRoot}/hooks/lib/core/pecot-gitignore-ensure.sh",
        "{projectRoot}/scripts/sandbox/**/*",
        "{workspaceRoot}/specs/026-pre-merge-test-env/spec.md",
        "{workspaceRoot}/.github/workflows/ci.yml",
        { "runtime": "node -p \"require('nx/package.json').version\"" },
        "^production",
        "{workspaceRoot}/libs/workflow-core/tests/_helpers/**/*",
        "{workspaceRoot}/libs/workflow-core/tests/python-output/**/*",
        "{workspaceRoot}/libs/workflow-core/src/infra/github/tests/fake-client.ts"
      ],
      "dependsOn": ["install", "build-cli", { "projects": ["workflow-core"], "target": "build" }],
      "outputs": ["{projectRoot}/cli/test-results/junit.xml", "{projectRoot}/test-results/test-cli/allure-results"],
      "metadata": {
        "description": "cli の vitest（project cli）。hooks/ を読むテストは tests/hooks/ に置き、test-hooks が実行するので、入力から tests/hooks/ を除く。前後比較のテスト（tests/parity/）は一時リポで git を起動するので、git のバージョンを runtime 入力に置く。cli/templates/・plugin.json・interface/ の定義書は、それぞれを読むテストのために宣言する。hooks/lib/core の pecot-gitignore-ensure.sh も同じ理由で宣言する。interface/ の GitHub の Issue の機能の写しと担保の一覧は、網羅のテスト（tests/issue-coverage.test.ts）が照らす対象なので宣言する。scripts/sandbox/ と spec 026 の spec.md は、tests/sandbox/ が動かして読むので宣言する。.github/workflows/ci.yml は、tests/interface/workflow-install.test.ts が CI の名前を読むので宣言する。nx のバージョンの runtime 入力は、実 nx の graph を読む契約テスト（infra/tests/nx-scope.test.ts）を nx の更新でキャッシュから外すために置く。libs/workflow-core の変更は、project graph の依存先として ^production が取り込む。cli が読む dist は、workflow-core:build が作る。cli のテストが相対パスで読む lib のテストのヘルパー・Python の出力の fixture・偽の GitHub のクライアントは ^production に入らないので宣言する。install と build は dependsOn 経由で 1 回だけ流し、run-tests.sh には PECOT_WORKFLOW_SKIP_INSTALL=1 を渡す。"
      },
      "options": {
        "command": "rm -rf test-results/test-cli/allure-results && PECOT_WORKFLOW_SKIP_INSTALL=1 bash scripts/ci/run-tests.sh --scope=cli",
        "cwd": "plugins/pecot-workflow"
      }
    },
    "test-bootstrap": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/cli/tests/bootstrap/**/*",
        "{projectRoot}/cli/src/**/*",
        "!{projectRoot}/cli/src/**/tests/**/*",
        "!{projectRoot}/cli/src/**/*.test.*",
        "{projectRoot}/cli/tsconfig.json",
        "{projectRoot}/cli/tsconfig.build.json",
        "{projectRoot}/cli/scripts/tsc.mjs",
        "{projectRoot}/.claude-plugin/plugin.json",
        "{projectRoot}/plugin.json",
        "{projectRoot}/mcp.json",
        "{projectRoot}/agents/*.md",
        "{projectRoot}/.mcp.json",
        "{projectRoot}/com.github.copilot/**/*",
        "{projectRoot}/bin/pecot",
        "{projectRoot}/scripts/ci/run-tests.sh",
        "sharedGlobals",
        "runtime",
        "env",
        "pecotPluginEnv",
        "pecotPluginNodeInputs",
        "^production"
      ],
      "dependsOn": ["install", "build-cli", { "projects": ["workflow-core"], "target": "build" }],
      "metadata": {
        "description": "bin/pecot の bootstrap と登録ファイルの bash テスト（約 1 分）。対象は run.sh、data-dir、manifest、install-record、workflow-core-link だ。実 pnpm でミラーを build する run.sh は、cli/src と vendor/workflow-core をミラーに build し、tools/list のツールの件数を確かめる。そのため cli/src を入力に置き（テストは除く）、libs/workflow-core は ^production で取り込む。登録ファイルと wrapper は inputs に宣言する。install は dependsOn 経由で実行ごとに 1 回だけ実行し、run-tests.sh には PECOT_WORKFLOW_SKIP_INSTALL=1 を渡す。"
      },
      "options": {
        "command": "PECOT_WORKFLOW_SKIP_INSTALL=1 bash scripts/ci/run-tests.sh --scope=bootstrap",
        "cwd": "plugins/pecot-workflow"
      }
    },
    "test-skills": {
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/libs/interface-spec/src/vitest/unique-titles.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/allure-reporter.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/attach.ts",
        "{projectRoot}/skills/**/*",
        "{projectRoot}/agents/*.md",
        "{projectRoot}/hooks/templates/*.md",
        "{projectRoot}/cli/templates/pr/create.md",
        "{projectRoot}/cli/templates/comment/plan.md",
        "{projectRoot}/cli/tests/skills/**/*",
        "{projectRoot}/cli/src/**/*",
        "{projectRoot}/cli/tests/_helpers/**/*",
        "{projectRoot}/cli/vitest.config.ts",
        "{projectRoot}/cli/tsconfig.json",
        "{projectRoot}/cli/tests/parity/baseline.ts",
        "{projectRoot}/cli/tests/parity/baseline.json",
        "{projectRoot}/scripts/ci/run-tests.sh",
        "sharedGlobals",
        "runtime",
        "env",
        "pecotPluginEnv",
        "pecotPluginNodeInputs",
        "{projectRoot}/.claude-plugin/plugin.json",
        "^production",
        "{workspaceRoot}/libs/workflow-core/tests/_helpers/**/*"
      ],
      "dependsOn": ["install", { "projects": ["workflow-core"], "target": "build" }],
      "outputs": ["{projectRoot}/cli/test-results/junit-skills.xml", "{projectRoot}/test-results/test-skills/allure-results"],
      "metadata": {
        "description": "skills テスト（cli/tests/skills/）の vitest（project skills）。skills・agents・hooks テンプレートの本文のツール名と入力名を、cli/src の COMMANDS の定義と照らして確かめる。w-release の docs PR の例は PR のテンプレート（cli/templates/pr/create.md）の節と照らす。tests/parity/baseline.ts は、並べ替えの関数を借りる。libs/workflow-core の変更は、project graph の依存先として ^production が取り込む。cli が読む dist は、workflow-core:build が作る。tests/skills が読む lib のテストのヘルパーは宣言する。install は dependsOn 経由で 1 回だけ流し、run-tests.sh には PECOT_WORKFLOW_SKIP_INSTALL=1 を渡す。"
      },
      "options": {
        "command": "rm -rf test-results/test-skills/allure-results && PECOT_WORKFLOW_SKIP_INSTALL=1 bash scripts/ci/run-tests.sh --scope=skills",
        "cwd": "plugins/pecot-workflow"
      }
    },
    "test-hooks": {
      "executor": "nx:run-commands",
      "inputs": [
        "{workspaceRoot}/libs/interface-spec/src/vitest/unique-titles.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/allure-reporter.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/attach.ts",
        "{projectRoot}/hooks/**/*",
        "sharedGlobals",
        "pecotPluginTestGlobals",
        "pecotPluginNodeInputs",
        "{projectRoot}/cli/tests/hooks/**/*",
        "{projectRoot}/cli/src/**/*",
        "!{projectRoot}/cli/src/**/tests/**/*",
        "!{projectRoot}/cli/src/**/*.test.*",
        "{projectRoot}/cli/tests/parity/baseline.json",
        "{projectRoot}/cli/tests/parity/baseline.ts",
        "{projectRoot}/cli/vitest.config.ts",
        "{workspaceRoot}/.githooks/pre-commit/check-entry-point-logic.sh",
        "{projectRoot}/agents/*.md",
        "{workspaceRoot}/plugins/pecot-visual/agents/*.md",
        "{projectRoot}/skills/*/SKILL.md",
        "{workspaceRoot}/plugins/pecot-visual/skills/*/SKILL.md",
        "{projectRoot}/.claude-plugin/plugin.json",
        "{projectRoot}/.mcp.json",
        "{projectRoot}/mcp.json",
        "{projectRoot}/plugin.json",
        "{projectRoot}/com.github.copilot/**/*",
        "{workspaceRoot}/plugins/pecot-visual/.mcp.json",
        "{projectRoot}/bin/pecot",
        "{projectRoot}/bin/_lib.sh",
        "{projectRoot}/skills/w-help/references/issue-flow-rules.md",
        "{projectRoot}/skills/w-help/references/cuj-run.md",
        "{projectRoot}/scripts/ci/run-lint.sh",
        "{projectRoot}/project.json",
        "{workspaceRoot}/plugins/pecot-visual/scripts/ci/run-lint.sh",
        "{workspaceRoot}/plugins/pecot-visual/scripts/ci/run-tests.sh",
        "{workspaceRoot}/plugins/pecot-visual/project.json",
        "{workspaceRoot}/plugins/pecot-tools/scripts/ci/run-lint.sh",
        "{workspaceRoot}/plugins/pecot-tools/scripts/ci/run-tests.sh",
        "{workspaceRoot}/plugins/pecot-tools/project.json",
        "{workspaceRoot}/plugins/pecot-visual/hooks/hooks*.json",
        "{workspaceRoot}/plugins/pecot-visual/com.github.copilot/hooks/hooks.json",
        "^production"
      ],
      "dependsOn": ["install", "build-cli", { "projects": ["workflow-core"], "target": "build" }],
      "outputs": ["{projectRoot}/cli/test-results/junit-hooks.xml", "{projectRoot}/test-results/test-hooks/allure-results"],
      "metadata": {
        "description": "hooks テスト（cli/tests/hooks/）の vitest（project hooks）を、通常の環境と空の設定の環境で 2 回流して結果を比べる。テストが読む hooks・agents・SKILL.md・plugin.json・bin/pecot・各 project.json と run-*.sh を宣言する。state-directory-resolution は build 済みの CLI を起動するので、build-cli を dependsOn に、cli/src を入力に置く。libs/workflow-core の変更は、project graph の依存先として ^production が取り込む。cli が読む dist は、workflow-core:build が作る。install は dependsOn 経由で 1 回だけ流し、run-tests.sh には PECOT_WORKFLOW_SKIP_INSTALL=1 を渡す。"
      },
      "options": {
        "command": "rm -rf test-results/test-hooks/allure-results && PECOT_WORKFLOW_SKIP_INSTALL=1 bash scripts/ci/run-tests.sh --scope=hooks",
        "cwd": "plugins/pecot-workflow"
      }
    },
    "test-release": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/scripts/release/**/*",
        "{projectRoot}/cli/templates/**/*",
        "{projectRoot}/hooks/lib/core/pecot-gitignore-ensure.sh",
        "{projectRoot}/.claude-plugin/plugin.json",
        "{projectRoot}/scripts/ci/run-tests.sh",
        "{projectRoot}/cli/src/commands/*.ts",
        "{projectRoot}/cli/src/mcp/server.ts",
        "{projectRoot}/cli/src/infra/template-store.ts",
        "{workspaceRoot}/LICENSE",
        "{workspaceRoot}/.githooks/lib/mcp-publish-common.sh",
        "{workspaceRoot}/.githooks/scripts/attach-mcp-tgz.sh",
        "{workspaceRoot}/.githooks/scripts/origin-slug.mjs",
        "{workspaceRoot}/.githooks/scripts/tests/mcp-publish-common.test.sh",
        "sharedGlobals",
        "runtime",
        "env",
        "pecotPluginEnv",
        "pecotPluginNodeInputs",
        "^production"
      ],
      "dependsOn": ["install", "build-cli", { "projects": ["workflow-core"], "target": "build" }],
      "metadata": {
        "description": "MCP 単体配布の publish スクリプトの確認。npm の依存解決でレジストリの状態を読むが、入力ハッシュには表せない。それでもキャッシュするのは、cli/src の 1 行修正のたびに実行しないため。レジストリ側の変化はリリース時の dry-run で拾う。ツールの一覧が決まる cli/src/commands・mcp/server.ts・template-store.ts だけを入力に置く。配布ツリーに同梱する libs/workflow-core は ^production で取り込み、dist は workflow-core:build が作る。dist は build-cli の dependsOn が用意する。npm の依存解決のキャッシュは PECOT_RELEASE_TEST_NPM_CACHE で永続化する。"
      },
      "options": {
        "command": "PECOT_WORKFLOW_SKIP_INSTALL=1 PECOT_RELEASE_TEST_NPM_CACHE=\"$PWD/../../.pecot/tmp/release-npm-cache/pecot-workflow\" bash scripts/ci/run-tests.sh --scope=release",
        "cwd": "plugins/pecot-workflow"
      }
    },
    "lint": {
      "executor": "nx:noop",
      "dependsOn": ["lint-cli"],
      "metadata": {
        "description": "lint のまとめ役。レーン（lint-cli）を束ねるだけで、実行するものは無い。pre-commit の nx-affected-lint は、まとめ役でなくレーン名を列挙して要求する。"
      }
    },
    "lint-cli": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/cli/**/*",
        "{projectRoot}/skills/*/scripts/*.cjs",
        "{projectRoot}/eslint.skills.config.mjs",
        "sharedGlobals",
        "runtime",
        "env",
        "pecotPluginEnv",
        "pecotPluginNodeInputs",
        "{projectRoot}/scripts/ci/run-lint.sh",
        "{workspaceRoot}/libs/interface-spec/src/eslint/describe-title.ts",
        "{workspaceRoot}/libs/interface-spec/src/eslint/table-key.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/allure-reporter.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/attach.ts",
        "{workspaceRoot}/libs/interface-spec/src/vitest/verifies.ts",
        "{projectRoot}/interface/generated.json",
        "{workspaceRoot}/libs/interface-spec/src/domain/diff.ts",
        "{workspaceRoot}/libs/interface-spec/src/domain/schema.ts",
        "{workspaceRoot}/libs/interface-spec/src/domain/utility.ts",
        "{workspaceRoot}/libs/interface-spec/package.json",
        "^production",
        "{workspaceRoot}/libs/workflow-core/tests/_helpers/**/*",
        "{workspaceRoot}/libs/workflow-core/tests/python-output/**/*",
        "{workspaceRoot}/libs/workflow-core/src/infra/github/tests/fake-client.ts",
        "{workspaceRoot}/libs/workflow-core/**/*.test.ts"
      ],
      "dependsOn": ["install", { "projects": ["workflow-core"], "target": "build" }],
      "metadata": {
        "description": "cli の tsc / eslint / knip と、スキルの scripts/*.cjs の eslint。tests/hooks/ も型の確認と eslint の対象なので、入力から除かない。libs/workflow-core の変更は、project graph の依存先として ^production が取り込む。cli が読む dist は、workflow-core:build が作る。cli のテストが読む lib のテストのヘルパーも型の確認の対象なので宣言する。2 つ目の knip は lib を使う cli も読み、lib の未使用の export を見る。lib のテストの使用も数えるので、lib のテストも宣言する。install は dependsOn 経由で実行ごとに 1 回だけ実行し、run-lint.sh には PECOT_WORKFLOW_SKIP_INSTALL=1 を渡す。"
      },
      "options": {
        "command": "PECOT_WORKFLOW_SKIP_INSTALL=1 bash scripts/ci/run-lint.sh --scope=cli",
        "cwd": "plugins/pecot-workflow"
      }
    },
    "nx-release-publish": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "配布ツリーを作って tgz を Release に添え、publish-npm.yml を起動する。"
      },
      "options": {
        "//forwardAllArgs-reason": "既定 true だと --dryRun=true が末尾に注入される。dry-run は NX_DRY_RUN で受ける。",
        "forwardAllArgs": false,
        "command": "bash scripts/release/publish-mcp-dist.sh",
        "cwd": "plugins/pecot-workflow"
      }
    }
  },
  "release": {
    "version": {
      "versionActions": "./.nx/nx-release/src/version-actions.js",
      "manifestRootsToUpdate": [
        { "path": "{projectRoot}/.claude-plugin" },
        { "path": "{projectRoot}" }
      ]
    }
  }
}
