{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "pecot-workflow",
  "projectType": "library",
  "tags": ["type:plugin", "scope:p-w"],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [{ "projects": ["pecot"], "target": "install" }],
      "metadata": {
        "description": "リポジトリ全体の依存導入は、root の project の install が 1 回の nx 実行につき 1 回だけ行う (#1080, #113)。各レーンはこの install を dependsOn で参照する。nx の task graph は、同じ project:target を 1 タスクにまとめる。そのため、実行するレーンが何本あっても、導入は 1 回になる。本ターゲットは pnpm を打たず、導入の後に scripts の package manager 自己呼び出しガード (#1217) を確かめる。cache: false は明示的な宣言。ガードは node_modules の状態に依らないが、cache を付けると、確認が 0 回になる。"
      },
      "options": {
        "command": "bash scripts/ci/check-pm-scripts.sh",
        "cwd": "plugins/pecot-workflow"
      }
    },
    "build-cli": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/cli/**/*",
        "!{projectRoot}/cli/**/*.md",
        "!{projectRoot}/cli/**/tests/**/*",
        "!{projectRoot}/cli/**/*.test.*",
        "!{projectRoot}/cli/dist/**/*",
        "sharedGlobals"
      ],
      "dependsOn": ["install"],
      "options": {
        "command": "pnpm --filter @pecot/pecot-workflow-cli run build",
        "cwd": "plugins/pecot-workflow"
      }
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": ["test-cli", "test-bootstrap", "test-hooks", "test-skills", "test-release"],
      "metadata": {
        "description": "CI と manual の stage の nx-affected-tests が起動する起点。レーン（test-*）はそれぞれの inputs でキャッシュされ、入力の変わったレーンだけが実行される。"
      }
    },
    "test-cli": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/cli/**/*",
        "{projectRoot}/skills/w-help/references/board-sync-workflow.md",
        "!{projectRoot}/cli/tests/hooks/**",
        "!{projectRoot}/cli/tests/bootstrap/**",
        "!{projectRoot}/cli/tests/skills/**",
        "sharedGlobals",
        "runtime",
        { "runtime": "git --version" },
        "env",
        "pecotPluginEnv",
        "pecotPluginNodeInputs",
        "{projectRoot}/.claude-plugin/plugin.json",
        "{projectRoot}/scripts/ci/run-tests.sh",
        "{projectRoot}/cli/templates/**/*",
        "{projectRoot}/interface/generated.json",
        "{projectRoot}/interface/authored.yaml",
        "{workspaceRoot}/libs/interface-spec/src/domain/diff.ts",
        "{workspaceRoot}/libs/interface-spec/src/domain/schema.ts",
        "{workspaceRoot}/libs/interface-spec/src/domain/utility.ts",
        "{workspaceRoot}/libs/interface-spec/package.json",
        "{projectRoot}/hooks/lib/core/pecot-gitignore-ensure.sh",
        "{projectRoot}/hooks/lib/core/pecot-tool-names.sh",
        { "runtime": "node -p \"require('nx/package.json').version\"" }
      ],
      "dependsOn": ["install", "build-cli"],
      "outputs": ["{projectRoot}/cli/test-results/junit.xml"],
      "metadata": {
        "description": "cli の vitest（project cli）。hooks/ を読むテストは tests/hooks/ に置き、test-hooks が実行するので、入力から tests/hooks/ を除く。前後比較のテスト（tests/parity/）は一時リポで git を起動するので、git のバージョンを runtime 入力に置く。cli/templates/・plugin.json・hooks/lib/core の 2 つのスクリプト・interface/ の定義書は、それぞれを読むテストのために宣言する。nx のバージョンの runtime 入力は、実 nx の graph を読む契約テスト（infra/tests/nx-scope.test.ts）を nx の更新でキャッシュから外すために置く。install と build は dependsOn 経由で 1 回だけ流し、run-tests.sh には PECOT_WORKFLOW_SKIP_INSTALL=1 を渡す。"
      },
      "options": {
        "command": "PECOT_WORKFLOW_SKIP_INSTALL=1 bash scripts/ci/run-tests.sh --scope=cli",
        "cwd": "plugins/pecot-workflow"
      }
    },
    "test-bootstrap": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/cli/tests/bootstrap/**/*",
        "{projectRoot}/cli/src/**/*",
        "!{projectRoot}/cli/src/**/tests/**/*",
        "!{projectRoot}/cli/src/**/*.test.*",
        "{projectRoot}/cli/tsconfig.json",
        "{projectRoot}/cli/tsconfig.build.json",
        "{projectRoot}/cli/scripts/tsc.mjs",
        "{projectRoot}/.claude-plugin/plugin.json",
        "{projectRoot}/plugin.json",
        "{projectRoot}/mcp.json",
        "{projectRoot}/agents/*.md",
        "{projectRoot}/.mcp.json",
        "{projectRoot}/com.github.copilot/**/*",
        "{projectRoot}/bin/pecot",
        "{projectRoot}/scripts/ci/run-tests.sh",
        "sharedGlobals",
        "runtime",
        "env",
        "pecotPluginEnv",
        "pecotPluginNodeInputs"
      ],
      "dependsOn": ["install", "build-cli"],
      "metadata": {
        "description": "bin/pecot の bootstrap と登録ファイルの bash テスト（run.sh、data-dir、manifest、install-record。約 1 分）。実 pnpm でミラーを build する run.sh は、実の cli/src をミラーに build し、tools/list の 36 件を確かめる。そのため cli/src を入力に置く（テストは除く）。登録ファイルと wrapper は inputs に宣言する。install は dependsOn 経由で実行ごとに 1 回だけ実行し、run-tests.sh には PECOT_WORKFLOW_SKIP_INSTALL=1 を渡す。"
      },
      "options": {
        "command": "PECOT_WORKFLOW_SKIP_INSTALL=1 bash scripts/ci/run-tests.sh --scope=bootstrap",
        "cwd": "plugins/pecot-workflow"
      }
    },
    "test-skills": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/skills/**/*",
        "{projectRoot}/agents/*.md",
        "{projectRoot}/hooks/templates/*.md",
        "{projectRoot}/cli/templates/pr/create.md",
        "{projectRoot}/cli/tests/skills/**/*",
        "{projectRoot}/cli/src/**/*",
        "{projectRoot}/cli/tests/_helpers/**/*",
        "{projectRoot}/cli/vitest.config.ts",
        "{projectRoot}/cli/tsconfig.json",
        "{projectRoot}/cli/tests/parity/baseline.ts",
        "{projectRoot}/cli/tests/parity/baseline.json",
        "{projectRoot}/scripts/ci/run-tests.sh",
        "sharedGlobals",
        "runtime",
        "env",
        "pecotPluginEnv",
        "pecotPluginNodeInputs",
        "{projectRoot}/.claude-plugin/plugin.json"
      ],
      "dependsOn": ["install"],
      "outputs": ["{projectRoot}/cli/test-results/junit-skills.xml"],
      "metadata": {
        "description": "skills テスト（cli/tests/skills/）の vitest（project skills）。skills・agents・hooks テンプレートの本文のツール名と入力名を、cli/src の COMMANDS の定義と照らして確かめる。w-release の docs PR の例は PR のテンプレート（cli/templates/pr/create.md）の節と照らす。tests/parity/baseline.ts は、並べ替えの関数を借りる。install は dependsOn 経由で 1 回だけ流し、run-tests.sh には PECOT_WORKFLOW_SKIP_INSTALL=1 を渡す。"
      },
      "options": {
        "command": "PECOT_WORKFLOW_SKIP_INSTALL=1 bash scripts/ci/run-tests.sh --scope=skills",
        "cwd": "plugins/pecot-workflow"
      }
    },
    "test-hooks": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/hooks/**/*",
        "sharedGlobals",
        "pecotPluginTestGlobals",
        "pecotPluginNodeInputs",
        "{projectRoot}/cli/tests/hooks/**/*",
        "{projectRoot}/cli/src/**/*",
        "!{projectRoot}/cli/src/**/tests/**/*",
        "!{projectRoot}/cli/src/**/*.test.*",
        "{projectRoot}/cli/tests/parity/baseline.json",
        "{projectRoot}/cli/tests/parity/baseline.ts",
        "{projectRoot}/cli/vitest.config.ts",
        "{workspaceRoot}/.githooks/pre-commit/check-entry-point-logic.sh",
        "{projectRoot}/agents/*.md",
        "{workspaceRoot}/plugins/pecot-visual/agents/*.md",
        "{projectRoot}/skills/*/SKILL.md",
        "{workspaceRoot}/plugins/pecot-visual/skills/*/SKILL.md",
        "{projectRoot}/.claude-plugin/plugin.json",
        "{projectRoot}/.mcp.json",
        "{projectRoot}/mcp.json",
        "{projectRoot}/plugin.json",
        "{projectRoot}/com.github.copilot/**/*",
        "{workspaceRoot}/plugins/pecot-visual/.mcp.json",
        "{projectRoot}/bin/pecot",
        "{projectRoot}/bin/_lib.sh",
        "{projectRoot}/skills/w-help/references/issue-flow-rules.md",
        "{projectRoot}/skills/w-merge/scripts/**/*",
        "{projectRoot}/scripts/ci/run-lint.sh",
        "{projectRoot}/project.json",
        "{workspaceRoot}/plugins/pecot-visual/scripts/ci/run-lint.sh",
        "{workspaceRoot}/plugins/pecot-visual/scripts/ci/run-tests.sh",
        "{workspaceRoot}/plugins/pecot-visual/project.json",
        "{workspaceRoot}/plugins/pecot-tools/scripts/ci/run-lint.sh",
        "{workspaceRoot}/plugins/pecot-tools/scripts/ci/run-tests.sh",
        "{workspaceRoot}/plugins/pecot-tools/project.json",
        "{workspaceRoot}/plugins/pecot-visual/hooks/hooks*.json",
        "{workspaceRoot}/plugins/pecot-visual/com.github.copilot/hooks/hooks.json"
      ],
      "dependsOn": ["install", "build-cli"],
      "outputs": ["{projectRoot}/cli/test-results/junit-hooks.xml"],
      "metadata": {
        "description": "hooks テスト（cli/tests/hooks/）の vitest（project hooks）を、通常の環境と空の設定の環境で 2 回流して結果を比べる。テストが読む hooks・agents・SKILL.md・plugin.json・bin/pecot・各 project.json と run-*.sh を宣言する。state-directory-resolution は build 済みの CLI を起動するので、build-cli を dependsOn に、cli/src を入力に置く。skills/w-merge/scripts/ は merge-wait.sh で、merge-wait.test.ts が読む。install は dependsOn 経由で 1 回だけ流し、run-tests.sh には PECOT_WORKFLOW_SKIP_INSTALL=1 を渡す。"
      },
      "options": {
        "command": "PECOT_WORKFLOW_SKIP_INSTALL=1 bash scripts/ci/run-tests.sh --scope=hooks",
        "cwd": "plugins/pecot-workflow"
      }
    },
    "test-release": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/scripts/release/**/*",
        "{projectRoot}/cli/templates/**/*",
        "{projectRoot}/hooks/lib/core/pecot-gitignore-ensure.sh",
        "{projectRoot}/.claude-plugin/plugin.json",
        "{projectRoot}/scripts/ci/run-tests.sh",
        "{projectRoot}/cli/src/commands/*.ts",
        "{projectRoot}/cli/src/mcp/server.ts",
        "{projectRoot}/cli/src/infra/template-store.ts",
        "{workspaceRoot}/LICENSE",
        "{workspaceRoot}/.githooks/lib/mcp-publish-common.sh",
        "{workspaceRoot}/.githooks/scripts/attach-mcp-tgz.sh",
        "{workspaceRoot}/.githooks/scripts/origin-slug.mjs",
        "{workspaceRoot}/.githooks/scripts/tests/mcp-publish-common.test.sh",
        "sharedGlobals",
        "runtime",
        "env",
        "pecotPluginEnv",
        "pecotPluginNodeInputs"
      ],
      "dependsOn": ["install", "build-cli"],
      "metadata": {
        "description": "MCP 単体配布の publish スクリプトの確認。npm の依存解決でレジストリの状態を読むが、入力ハッシュには表せない。それでもキャッシュするのは、cli/src の 1 行修正のたびに実行しないため。レジストリ側の変化はリリース時の dry-run で拾う。ツールの一覧が決まる cli/src/commands・mcp/server.ts・template-store.ts だけを入力に置く。dist は build-cli の dependsOn が用意する。npm の依存解決のキャッシュは PECOT_RELEASE_TEST_NPM_CACHE で永続化する。"
      },
      "options": {
        "command": "PECOT_WORKFLOW_SKIP_INSTALL=1 PECOT_RELEASE_TEST_NPM_CACHE=\"$PWD/../../.pecot/tmp/release-npm-cache/pecot-workflow\" bash scripts/ci/run-tests.sh --scope=release",
        "cwd": "plugins/pecot-workflow"
      }
    },
    "lint": {
      "executor": "nx:noop",
      "dependsOn": ["lint-cli"],
      "metadata": {
        "description": "lint のまとめ役。レーン（lint-cli）を束ねるだけで、実行するものは無い。pre-commit の nx-affected-lint は、まとめ役でなくレーン名を列挙して要求する。"
      }
    },
    "lint-cli": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/cli/**/*",
        "sharedGlobals",
        "runtime",
        "env",
        "pecotPluginEnv",
        "pecotPluginNodeInputs",
        "{projectRoot}/scripts/ci/run-lint.sh",
        "{workspaceRoot}/libs/interface-spec/src/eslint/describe-title.ts",
        "{projectRoot}/interface/generated.json",
        "{workspaceRoot}/libs/interface-spec/src/domain/diff.ts",
        "{workspaceRoot}/libs/interface-spec/src/domain/schema.ts",
        "{workspaceRoot}/libs/interface-spec/src/domain/utility.ts",
        "{workspaceRoot}/libs/interface-spec/package.json"
      ],
      "dependsOn": ["install"],
      "metadata": {
        "description": "cli の tsc / eslint / knip。tests/hooks/ も型の確認と eslint の対象なので、入力から除かない。install は dependsOn 経由で実行ごとに 1 回だけ実行し、run-lint.sh には PECOT_WORKFLOW_SKIP_INSTALL=1 を渡す。"
      },
      "options": {
        "command": "PECOT_WORKFLOW_SKIP_INSTALL=1 bash scripts/ci/run-lint.sh --scope=cli",
        "cwd": "plugins/pecot-workflow"
      }
    },
    "nx-release-publish": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "配布ツリーを作って tgz を Release に添え、publish-npm.yml を起動する。"
      },
      "options": {
        "//forwardAllArgs-reason": "既定 true だと --dryRun=true が末尾に注入される。dry-run は NX_DRY_RUN で受ける。",
        "forwardAllArgs": false,
        "command": "bash scripts/release/publish-mcp-dist.sh",
        "cwd": "plugins/pecot-workflow"
      }
    }
  },
  "release": {
    "version": {
      "versionActions": "./.nx/nx-release/src/version-actions.js",
      "manifestRootsToUpdate": [
        { "path": "{projectRoot}/.claude-plugin" },
        { "path": "{projectRoot}" }
      ]
    }
  }
}
