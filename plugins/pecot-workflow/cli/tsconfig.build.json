{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": false
  },
  "include": ["src/**/*"],
  // issue-surface と issue-surface-tracker は scripts/github-surface だけが使う。graphql を読むので配布に入れない
  "exclude": ["dist", "coverage", "node_modules", "tests", "**/tests/**", "src/**/*.test.ts", "src/**/issue-surface.ts", "src/**/issue-surface-tracker.ts"]
}
