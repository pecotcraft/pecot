{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": false
  },
  "include": ["src/**/*"],
  // issue-surface は scripts/github-surface だけが使い、devDependencies の graphql を読むので配布に入れない
  "exclude": ["dist", "coverage", "node_modules", "tests", "**/tests/**", "src/**/*.test.ts", "src/**/issue-surface.ts"]
}
