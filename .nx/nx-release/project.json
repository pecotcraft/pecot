{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "nx-release",
  "projectType": "library",
  "tags": [
    "type:release",
    "scope:repo"
  ],
  "targets": {
    "test": {
      "executor": "nx:noop",
      "dependsOn": [
        "test-unit",
        "test-canary"
      ],
      "metadata": {
        "description": "pre-push の nx-affected-tests が起動する起点。プラグインの project と同じく、レーン（test-*）を dependsOn で束ねる。"
      }
    },
    "test-unit": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "runtime",
        "env",
        {
          "runtime": "node -p \"require('nx/package.json').version\""
        },
        {
          "runtime": "node -p \"require('undici/package.json').version\""
        },
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/plugins/pecot-workflow/project.json",
        "{workspaceRoot}/plugins/pecot-visual/project.json",
        "{workspaceRoot}/plugins/pecot-tools/project.json",
        "{workspaceRoot}/libs/text-rules/project.json",
        "{workspaceRoot}/libs/text-rules/package.json",
        "{workspaceRoot}/plugins/pecot-workflow/.claude-plugin/plugin.json",
        "{workspaceRoot}/plugins/pecot-workflow/.github/plugin/plugin.json",
        "{workspaceRoot}/plugins/pecot-visual/.claude-plugin/plugin.json",
        "{workspaceRoot}/plugins/pecot-visual/plugin.json",
        "{workspaceRoot}/plugins/pecot-tools/.claude-plugin/plugin.json",
        "{workspaceRoot}/plugins/pecot-tools/plugin.json"
      ],
      "metadata": {
        "description": "PecotVersionActions（nx release の versionActions）の単体テスト。inputs は、nx の実体の版と undici の実体の版を runtime 入力（node -p）で見る。root の pnpm-lock.yaml は .nxignore で入力から外れるため、lock ではなく実体を見る (#1225)。"
      },
      "options": {
        "command": "node --test tests/*.test.js",
        "cwd": ".nx/nx-release"
      }
    },
    "test-canary": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "#133 の E2E の仮のレーン。revert する。"
      },
      "options": {
        "command": "test -z \"$CI\""
      }
    }
  }
}
