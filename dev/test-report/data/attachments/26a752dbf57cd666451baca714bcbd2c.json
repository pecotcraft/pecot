{
  "cache": true,
  "inputs": [
    "{workspaceRoot}/.githooks/test-layers.txt",
    "{projectRoot}/test-layers.txt",
    "{workspaceRoot}/.githooks/scripts/test_report/allure-result.sh",
    "{workspaceRoot}/.githooks/scripts/test_report/bats/**/*",
    "{projectRoot}/scripts/release/**/*",
    "{projectRoot}/scripts/ci/pnpm-lib.sh",
    "{workspaceRoot}/LICENSE",
    "{workspaceRoot}/.githooks/lib/mcp-publish-common.sh",
    "{workspaceRoot}/.githooks/scripts/attach-mcp-tgz.sh",
    "{workspaceRoot}/.githooks/scripts/origin-slug.mjs",
    "{workspaceRoot}/.githooks/scripts/tests/attach-mcp-tgz.bats",
    "{workspaceRoot}/.githooks/scripts/tests/mcp-publish-common.bats",
    "sharedGlobals",
    "pecotvPluginTestGlobals",
    "{projectRoot}/.claude-plugin/plugin.json",
    "^production"
  ],
  "executor": "nx:run-commands",
  "dependsOn": [
    "install",
    "check-pm-guard",
    "build-cli",
    "build-slidev",
    {
      "projects": [
        "text-rules"
      ],
      "target": "build"
    }
  ],
  "//command-reason": "PECOT_RELEASE_TEST_NPM_CACHE は絶対パスで渡すため、cwd からの $PWD で組む (#1225)。",
  "outputs": [
    "{projectRoot}/test-results/test-release/allure-results"
  ],
  "metadata": {
    "description": "MCP 単体配布の publish スクリプトの検証。cache: true (#1225)。publish のテストは、npm の依存解決で外部レジストリの状態を読む。その状態は入力ハッシュに表せない。それでもキャッシュするのは、cli/src や SKILL.md を 1 行直すたびに本レーンを実行しないためとなる。レジストリ側の変化は、リリース時の dry-run と監査で拾う。依存解決の npm キャッシュは PECOT_RELEASE_TEST_NPM_CACHE で永続化し、実行時にも 2 回目以降はレジストリへアクセスしない。audit のテストは常に使い捨てのキャッシュを使い、この永続キャッシュは使わない。掃除は .pecot/tmp/release-npm-cache/pecot-visual を消す。packument の分だけ増え続ける。"
  },
  "options": {
    "command": "rm -rf test-results/test-release/allure-results && PECOTV_SKIP_INSTALL=1 PECOT_RELEASE_TEST_NPM_CACHE=\"$PWD/../../.pecot/tmp/release-npm-cache/pecot-visual\" bash scripts/ci/run-tests.sh --scope=release",
    "cwd": "plugins/pecot-visual"
  },
  "configurations": {},
  "parallelism": true
}