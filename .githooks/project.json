{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "githooks",
  "projectType": "library",
  "tags": [
    "scope:repo"
  ],
  "targets": {
    "test": {
      "executor": "nx:noop",
      "cache": false,
      "dependsOn": [
        "test-nx-cache",
        "test-nx-affected",
        "test-ci",
        "test-checks"
      ],
      "metadata": {
        "description": "CI と manual の stage の nx-affected-tests が起動する起点の target。レーン（test-*）はそれぞれの inputs でキャッシュされる。"
      }
    },
    "test-nx-cache": {
      "executor": "nx:run-commands",
      "inputs": [
        "githooksTestGlobals",
        "githooksGraphInputs",
        "{projectRoot}/tests/test_nx_task_cache.py",
        {
          "runtime": "git ls-files -- plugins/pecot-visual/assets/slidev/deck-lint.config.js plugins/pecot-visual/assets/slidev/deck-lint.env.config.js plugins/pecot-visual/assets/slidev/scripts/eslint/slidev-pages-lint/index.ts plugins/pecot-visual/assets/slidev/scripts/eslint/validate-references/index.ts plugins/pecot-visual/assets/slidev/scripts/eslint/validate-references/lib/schema-validator.ts plugins/pecot-visual/cli/tests/fixtures/themes/with-declaration/references/plain.yaml | git hash-object --stdin"
        },
        "{projectRoot}/ci/run-affected-tests.sh",
        "{projectRoot}/pre-commit/run-affected-lint.sh"
      ],
      "dependsOn": [
        {
          "projects": [
            "pecot"
          ],
          "target": "install"
        }
      ],
      "metadata": {
        "description": "実 nx の graph と、フィクスチャでのキャッシュの再利用を確かめる。実リポの特定のファイルの実在は runtime 入力で見る。それ以外の実リポのファイルを読む確認は入力に無い。"
      },
      "options": {
        "command": ".githooks/tests/run.sh .githooks/tests/test_nx_task_cache.py",
        "cwd": "."
      }
    },
    "test-nx-affected": {
      "executor": "nx:run-commands",
      "inputs": [
        "githooksTestGlobals",
        "githooksGraphInputs",
        "{projectRoot}/tests/test_nx_affected_mapping.py",
        {
          "runtime": "git ls-files -- $(cat .githooks/tests/representative-files.txt) | git hash-object --stdin"
        },
        {
          "runtime": "git ls-files -- plugins/pecot-workflow/cli/src | git hash-object --stdin"
        },
        "{workspaceRoot}/libs/interface-spec/targets.json",
        "{projectRoot}/tests/representative-files.txt"
      ],
      "dependsOn": [
        {
          "projects": [
            "pecot"
          ],
          "target": "install"
        }
      ],
      "metadata": {
        "description": "実 nx の affected とレーン入力の対応を確かめる。代表ファイルの実在は representative-files.txt の runtime 入力で見る。cli/src のファイルの増減は runtime 入力で見る。"
      },
      "options": {
        "command": ".githooks/tests/run.sh .githooks/tests/test_nx_affected_mapping.py",
        "cwd": "."
      }
    },
    "test-ci": {
      "executor": "nx:run-commands",
      "inputs": [
        "githooksTestGlobals",
        "{projectRoot}/tests/test_run_pr_checks.py",
        "{projectRoot}/tests/test_run_affected_tests.py",
        "{projectRoot}/tests/test_run_affected_lint.py",
        "{projectRoot}/tests/test_list_test_lanes.py",
        "{projectRoot}/tests/test_fetch_pr_nx_cache.py",
        "{projectRoot}/tests/test_find_pr_ci_base.py",
        "{projectRoot}/tests/test_pr_run.py",
        "{projectRoot}/tests/test_nx_cache_server.py",
        "{projectRoot}/tests/test_dev_container.py",
        "{projectRoot}/tests/test_check_ci_result.py",
        "{projectRoot}/tests/test_with_timing.py",
        "{projectRoot}/tests/test_push_range_env_isolation.py",
        "{projectRoot}/ci/**/*",
        "{projectRoot}/pre-commit/run-affected-lint.sh",
        "{projectRoot}/pre-push/check-version-plan-required.sh"
      ],
      "dependsOn": [
        {
          "projects": [
            "pecot"
          ],
          "target": "install"
        }
      ],
      "metadata": {
        "description": "CI のスクリプト（run-pr-checks・run-affected-*・キャッシュの取り込みとサーバ・dev-container）のテスト。"
      },
      "options": {
        "command": ".githooks/tests/run.sh .githooks/tests/test_run_pr_checks.py .githooks/tests/test_run_affected_tests.py .githooks/tests/test_run_affected_lint.py .githooks/tests/test_list_test_lanes.py .githooks/tests/test_fetch_pr_nx_cache.py .githooks/tests/test_find_pr_ci_base.py .githooks/tests/test_pr_run.py .githooks/tests/test_nx_cache_server.py .githooks/tests/test_dev_container.py .githooks/tests/test_check_ci_result.py .githooks/tests/test_with_timing.py .githooks/tests/test_push_range_env_isolation.py",
        "cwd": "."
      }
    },
    "test-checks": {
      "executor": "nx:run-commands",
      "inputs": [
        "githooksTestGlobals",
        "githooksGraphInputs",
        "{projectRoot}/tests/test_*.py",
        "{projectRoot}/ci/run-affected-tests.sh",
        "{projectRoot}/commit-msg/**/*",
        "{projectRoot}/pre-commit/**/*",
        "{projectRoot}/pre-push/**/*",
        "{projectRoot}/gitlint/**/*",
        "{projectRoot}/scripts/gen-runtime-lock.mjs",
        "{projectRoot}/scripts/sync-playwright-deps.mjs",
        "{projectRoot}/scripts/run-lint.sh",
        "{projectRoot}/scripts/run-pnpm.sh",
        "{projectRoot}/scripts/release-land.sh",
        {
          "input": "production",
          "projects": [
            "text-rules"
          ]
        },
        "{workspaceRoot}/.pre-commit-config.yaml",
        "{workspaceRoot}/.gitlint",
        "{workspaceRoot}/.github/workflows/ci.yml",
        "{workspaceRoot}/.github/workflows/dependabot-commit.yml",
        "{workspaceRoot}/.github/workflows/devcontainer-image.yml",
        "{workspaceRoot}/.github/workflows/release.yml",
        "{workspaceRoot}/.github/workflows/dependabot-auto-merge.yml",
        "{workspaceRoot}/.github/workflows/pecot-board-sync.yml",
        "{workspaceRoot}/plugins/pecot-workflow/cli/templates/workflow/pecot-board-sync.yml",
        "{workspaceRoot}/.nx/nx-release/src/dependabot-plans.js",
        "{workspaceRoot}/.github/rulesets/main.json",
        "{workspaceRoot}/.github/board-sync/**/*",
        "{workspaceRoot}/.github/plugin/marketplace.json",
        "{workspaceRoot}/.claude-plugin/marketplace.json",
        "{workspaceRoot}/.claude/rules/repo-root-layout.md",
        "{workspaceRoot}/pyproject.toml",
        "{workspaceRoot}/uv.lock",
        "{workspaceRoot}/plugins/pecot-workflow/scripts/ci/run-tests.sh",
        "{workspaceRoot}/plugins/pecot-workflow/scripts/ci/run-lint.sh",
        "{workspaceRoot}/plugins/*/hooks/lib/session-start/plugin-update-notice.sh",
        "{workspaceRoot}/plugins/pecot-workflow/cli/tests/output/cases.json",
        "{workspaceRoot}/plugins/pecot-visual/cli/tests/diagnostics-cases.json",
        "{workspaceRoot}/plugins/pecot-tools/cli/tests/diagnostics-cases.json",
        "{workspaceRoot}/plugins/*/runtime-lock.yaml",
        "{workspaceRoot}/plugins/*/runtime-workspace.yaml",
        "{workspaceRoot}/libs/*/runtime-lock.yaml",
        "{workspaceRoot}/libs/*/runtime-workspace.yaml"
      ],
      "dependsOn": [
        {
          "projects": [
            "pecot"
          ],
          "target": "install"
        },
        {
          "projects": [
            "text-rules"
          ],
          "target": "build"
        }
      ],
      "metadata": {
        "description": "hook と設定の整合のテスト。実リポ全体を読む test_check_root_entries と test_plugin_validate は、入力に入れない。checks (lint) の check-root-entries と plugin-validate が受け持つため。test_nx_env_inputs の走査範囲も nx-env-inputs が受け持つ。"
      },
      "options": {
        "command": ".githooks/tests/run.sh .githooks/tests/test_board_sync.py .githooks/tests/test_board_sync_workflow_copy.py .githooks/tests/test_check_direct_commit.py .githooks/tests/test_check_engines_node_drift.py .githooks/tests/test_check_misplaced_pecot.py .githooks/tests/test_check_release_group_changelog.py .githooks/tests/test_check_root_entries.py .githooks/tests/test_check_skill_doc_direct_call.py .githooks/tests/test_check_text.py .githooks/tests/test_check_version_plan_format.py .githooks/tests/test_devcontainer_playwright_version.py .githooks/tests/test_entry_point_linter.py .githooks/tests/test_gen_runtime_lock.py .githooks/tests/test_githooks_lanes.py .githooks/tests/test_gitlint_japanese_rule.py .githooks/tests/test_marketplace_parity.py .githooks/tests/test_nx_env_inputs.py .githooks/tests/test_plugin_update_notice_parity.py .githooks/tests/test_plugin_validate.py .githooks/tests/test_pre_commit_config_wiring.py .githooks/tests/test_root_package_manifest.py .githooks/tests/test_ruleset_main.py .githooks/tests/test_run_pnpm.py .githooks/tests/test_check_version_plan_required.py .githooks/tests/test_cli_output_lines_match.py .githooks/tests/test_sync_playwright_deps.py .githooks/tests/test_dependabot_commit_workflow.py .githooks/tests/test_release_workflow.py",
        "cwd": "."
      }
    }
  }
}
