{
  "name": "@pecot/actions",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "利用者のリポのワークフローが uses: で呼ぶ GitHub Actions の action と、ワークフローの雛形。",
  "type": "module",
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "rollup --config rollup.config.mjs",
    "lint": "node scripts/tsc.mjs --noEmit && eslint --max-warnings=0 . && knip",
    "sync-templates": "tsx scripts/sync-plugin-templates.ts"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@pecot/workflow-core": "workspace:@pecot/workflow-core-src@*",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "knip": {
    "entry": [
      "src/*.ts",
      "scripts/**/*.{ts,mjs}",
      "tests/_helpers/**/*.ts"
    ],
    "project": [
      "src/**/*.ts",
      "scripts/**/*.{ts,mjs}",
      "tests/**/*.ts"
    ],
    "ignoreDependencies": [
      "typescript7"
    ],
    "ignoreExportsUsedInFile": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.11",
    "@vitest/coverage-v8": "^5.1.2",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-n": "^18.6.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "^6.48.0",
    "rollup": "^4.68.8",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.74.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^5.1.2"
  }
}
