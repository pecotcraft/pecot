---
extends: default

rules:
  line-length: disable
  document-start: disable
  comments:
    min-spaces-from-content: 1
  truthy:
    allowed-values: ['true', 'false']
    check-keys: false
  indentation:
    spaces: 2
    indent-sequences: consistent
    check-multi-line-strings: false

# pnpm が書く生成物。
ignore: |
  pnpm-lock.yaml
  runtime-lock.yaml
