# Gitlint configuration
# https://jorisroovers.com/gitlint/

[general]
# Enable Conventional Commits contrib rule
contrib = contrib-title-conventional-commits

# Custom rules directory
extra-path = .githooks/gitlint/

# Ignore body-is-missing rule (body is optional)
ignore = B6

[title-max-length]
line-length = 72

[title-min-length]
min-length = 10

[body-max-line-length]
line-length = 80

# Conventional Commits configuration
[contrib-title-conventional-commits]
types = feat,fix,docs,chore,refactor,test,ci,build,perf,revert

# Custom rule: Japanese required
[title-requires-japanese]
allow-revert = true
allow-release = true
allow-dependabot = true
