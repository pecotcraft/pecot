{
  "cache": true,
  "inputs": [
    "{projectRoot}/test-layers.txt",
    "{workspaceRoot}/.githooks/scripts/test_report/bash-test.sh",
    "{workspaceRoot}/.githooks/scripts/test_report/allure-result.sh",
    "{projectRoot}/scripts/release/**/*",
    "{projectRoot}/cli/templates/**/*",
    "{projectRoot}/hooks/lib/core/pecot-gitignore-ensure.sh",
    "{projectRoot}/.claude-plugin/plugin.json",
    "{projectRoot}/scripts/ci/run-tests.sh",
    "{projectRoot}/cli/src/commands/*.ts",
    "{projectRoot}/cli/src/mcp/server.ts",
    "{projectRoot}/cli/src/infra/template-store.ts",
    "{workspaceRoot}/LICENSE",
    "{workspaceRoot}/.githooks/lib/mcp-publish-common.sh",
    "{workspaceRoot}/.githooks/scripts/attach-mcp-tgz.sh",
    "{workspaceRoot}/.githooks/scripts/origin-slug.mjs",
    "{workspaceRoot}/.githooks/scripts/tests/mcp-publish-common.test.sh",
    "sharedGlobals",
    "runtime",
    "env",
    "pecotPluginEnv",
    "pecotPluginNodeInputs",
    "^production"
  ],
  "executor": "nx:run-commands",
  "dependsOn": [
    "install",
    "build-cli",
    {
      "projects": [
        "workflow-core"
      ],
      "target": "build"
    }
  ],
  "outputs": [
    "{projectRoot}/test-results/test-release/allure-results"
  ],
  "metadata": {
    "description": "MCP 単体配布の publish スクリプトの確認。npm の依存解決でレジストリの状態を読むが、入力ハッシュには表せない。それでもキャッシュするのは、cli/src の 1 行修正のたびに実行しないため。レジストリ側の変化はリリース時の dry-run で拾う。ツールの一覧が決まる cli/src/commands・mcp/server.ts・template-store.ts だけを入力に置く。配布ツリーに同梱する libs/workflow-core は ^production で取り込み、dist は workflow-core:build が作る。dist は build-cli の dependsOn が用意する。npm の依存解決のキャッシュは PECOT_RELEASE_TEST_NPM_CACHE で永続化する。"
  },
  "options": {
    "command": "rm -rf test-results/test-release/allure-results && PECOT_WORKFLOW_SKIP_INSTALL=1 PECOT_RELEASE_TEST_NPM_CACHE=\"$PWD/../../.pecot/tmp/release-npm-cache/pecot-workflow\" bash scripts/ci/run-tests.sh --scope=release",
    "cwd": "plugins/pecot-workflow"
  },
  "configurations": {},
  "parallelism": true
}