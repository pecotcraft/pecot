{
  "name": "slide_theme",
  "title": "Get Slidev theme",
  "description": "Returns the theme declaration referenced by a talk-dir and the list of layouts. The declaration covers fonts, font sizes, PPTX fonts and link colors, and lint rules. Skills use it to obtain theme values.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "dir": {
        "type": "string",
        "description": "Absolute path of the talk-dir whose theme to inspect. Relative paths are not accepted. Windows-style paths (C:\\... / \\\\wsl.localhost\\<distro>\\...) are accepted and converted to an absolute path under /mnt/<drive>/ or inside WSL."
      }
    },
    "required": [
      "dir"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "event": {
        "type": "string",
        "description": "slide.theme.done on success, slide.theme.error on failure (omitted when a path argument is rejected)"
      },
      "theme": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Package name of the theme"
          },
          "spec": {
            "type": "string",
            "description": "Theme specification in the dependencies of package.json"
          },
          "declared": {
            "type": "boolean",
            "description": "Whether the theme has pecot-theme.json"
          },
          "directory": {
            "type": "string",
            "description": "Absolute path of the theme root"
          },
          "linked": {
            "type": "boolean",
            "description": "Whether the theme was found in node_modules directly under the talk-dir"
          }
        },
        "required": [
          "name",
          "spec",
          "declared",
          "directory",
          "linked"
        ],
        "additionalProperties": false,
        "description": "Theme the talk-dir references (success only)"
      },
      "declaration": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "number"
          },
          "slide": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            },
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "fonts": {
            "type": "object",
            "properties": {
              "body": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "heading": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "eastAsian": {
                "type": "string"
              }
            },
            "required": [
              "body",
              "heading"
            ],
            "additionalProperties": false
          },
          "fontSizes": {
            "type": "object",
            "properties": {
              "heading": {
                "type": "number"
              },
              "headingSm": {
                "type": "number"
              },
              "body": {
                "type": "number"
              },
              "bodySm": {
                "type": "number"
              },
              "label": {
                "type": "number"
              }
            },
            "required": [
              "heading",
              "headingSm",
              "body",
              "bodySm",
              "label"
            ],
            "additionalProperties": false
          },
          "pptx": {
            "type": "object",
            "properties": {
              "eastAsianFont": {
                "type": "string"
              },
              "linkColor": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "lint": {
            "type": "object",
            "properties": {
              "rules": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "error",
                    "warn",
                    "off"
                  ]
                },
                "description": "Severity per lint rule ID"
              }
            },
            "required": [
              "rules"
            ],
            "additionalProperties": false
          },
          "layouts": {
            "type": "object",
            "properties": {
              "references": {
                "type": "string"
              }
            },
            "required": [
              "references"
            ],
            "additionalProperties": false
          },
          "drawio": {
            "type": "object",
            "properties": {
              "panels": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "width": {
                      "type": "number"
                    },
                    "height": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "width",
                    "height"
                  ],
                  "additionalProperties": false
                },
                "description": "Panel size of the diagram per layout name"
              },
              "markerLayouts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "panels",
              "markerLayouts"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "schema",
          "slide",
          "fonts",
          "fontSizes",
          "pptx",
          "lint",
          "layouts",
          "drawio"
        ],
        "additionalProperties": false,
        "description": "Theme declaration with omitted items filled with defaults (success only)"
      },
      "categories": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Category ID that layouts[].category refers to"
            },
            "label": {
              "type": "string",
              "description": "Display name of the category"
            },
            "question": {
              "type": "string",
              "description": "Question that tells when to choose the category"
            }
          },
          "required": [
            "id",
            "label",
            "question"
          ],
          "additionalProperties": false
        },
        "description": "Presentation categories declared by the theme (success only)"
      },
      "layouts": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "layout": {
              "type": "string",
              "description": "Layout name"
            },
            "description": {
              "type": "string",
              "description": "What the layout is for"
            },
            "category": {
              "type": "string",
              "description": "Category ID (uncategorized when unset or unknown)"
            },
            "deprecated": {
              "type": "boolean",
              "description": "Whether the layout is deprecated (not to be chosen)"
            },
            "filename": {
              "type": "string",
              "description": "File name of the reference yaml"
            }
          },
          "required": [
            "layout",
            "description",
            "category",
            "deprecated",
            "filename"
          ],
          "additionalProperties": false
        },
        "description": "Selectable layouts (hidden layouts are excluded) (success only)"
      },
      "lint": {
        "type": "object",
        "properties": {
          "referencesDirectories": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Directories searched for reference yaml, in priority order"
          },
          "panels": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                }
              },
              "required": [
                "width",
                "height"
              ],
              "additionalProperties": false
            },
            "description": "Panel size of the diagram per layout name"
          },
          "markerLayouts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Layout names that have marker cells"
          },
          "rules": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "error",
                "warn",
                "off"
              ]
            },
            "description": "Severity per lint rule ID"
          }
        },
        "required": [
          "referencesDirectories",
          "panels",
          "markerLayouts",
          "rules"
        ],
        "additionalProperties": false,
        "description": "Input passed to the deck lint (success only)"
      },
      "invalidPaths": {
        "description": "Rejected path arguments as <parameter>=<value> (failure only, kind invalid-path)",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "convertedPaths": {
        "description": "Windows-style path arguments converted before the rejection, keyed by parameter name (failure only, kind invalid-path; omitted when nothing was converted)",
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "description": "Value that was passed"
            },
            "to": {
              "type": "string",
              "description": "Path it was converted to"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        }
      },
      "kind": {
        "type": "string",
        "description": "Failure kind (failure only)"
      },
      "detail": {
        "type": "string",
        "description": "Full text of the failure and how to recover (failure only)"
      },
      "log": {
        "type": "string",
        "description": "Raw output of the command or child process (failure only). Over 64KB, the end is kept and the first line notes the truncation"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Warnings raised during the run (omitted when there are none). Beyond 100 warnings or 64KB, the last item tells how many were omitted"
      }
    },
    "additionalProperties": false,
    "anyOf": [
      {
        "required": [
          "event",
          "theme",
          "declaration",
          "categories",
          "layouts",
          "lint"
        ]
      },
      {
        "required": [
          "kind",
          "detail"
        ]
      }
    ]
  },
  "annotations": {
    "readOnlyHint": true,
    "openWorldHint": false
  }
}