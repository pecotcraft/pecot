{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "HistoryObject",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::pecot-test-report-history-<ACCOUNT_ID>/release/history.jsonl"
    },
    {
      "Sid": "HistoryList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::pecot-test-report-history-<ACCOUNT_ID>"
    }
  ]
}
