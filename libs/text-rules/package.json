{
  "name": "@pecot/text-rules-src",
  "version": "0.2.4",
  "private": true,
  "license": "MIT",
  "description": "テキスト規則ライブラリの実体。textlint の preset とカスタム規則を束ね、root フックと pecot-visual の同梱が使う。",
  "type": "module",
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "pecot-text-lint": "./dist/bin/pecot-text-lint.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/tsc.mjs --noEmit && eslint --max-warnings=0 ."
  },
  "dependencies": {
    "@cffnpwr/textlint-plugin-comments": "1.0.0",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
    "@textlint/kernel": "^15.8.0",
    "@textlint/module-interop": "^15.8.0",
    "@textlint/textlint-plugin-markdown": "^15.8.0",
    "textlint": "^15.8.0",
    "textlint-rule-preset-ai-words-ja": "1.2.1",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "web-tree-sitter": "0.27.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@textlint/types": "^15.8.0",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^5.1.0"
  }
}
