{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "text-rules",
  "projectType": "library",
  "tags": [
    "type:lib",
    "scope:libs"
  ],
  "targets": {
    "install": {
      "executor": "nx:noop",
      "cache": false,
      "dependsOn": [
        {
          "projects": [
            "pecot-visual"
          ],
          "target": "install"
        }
      ],
      "metadata": {
        "description": "依存の置き直しは pecot-visual:install が行う。pecot-visual の pnpm install は libs/text-rules/node_modules を削るため、その最後に npm ci で戻す。このターゲットは何もせず、pecot-visual:install の後に動く順序だけを build / lint / test-unit に与える。cache: false は明示的な宣言で、何もしないので、キャッシュしても省ける処理が無い。"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "production",
        "sharedGlobals"
      ],
      "dependsOn": [
        "install"
      ],
      "metadata": {
        "description": "dist を作る。root フック・pecot-visual の同梱・ミラーがこの dist を使う。dist/source-hash に入力のハッシュを書く。root フックがこれで dist の鮮度を見る (#1331)。cache: false は dist を outputs に宣言せず、毎回作り直すため。"
      },
      "options": {
        "command": "npm run build",
        "cwd": "libs/text-rules"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "runtime",
        "env"
      ],
      "dependsOn": [
        "install"
      ],
      "metadata": {
        "description": "型チェック（typescript7 の tsc --noEmit）と eslint（警告も失敗）。"
      },
      "options": {
        "command": "npm run lint",
        "cwd": "libs/text-rules"
      }
    },
    "test": {
      "executor": "nx:noop",
      "cache": false,
      "dependsOn": [
        "test-unit"
      ],
      "metadata": {
        "description": "pre-push の nx-affected-tests が起動するターゲット。プラグインの project と同じく、レーン（test-*）を dependsOn で束ねる。"
      }
    },
    "test-unit": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "runtime",
        "env"
      ],
      "dependsOn": [
        "install",
        "build"
      ],
      "metadata": {
        "description": "vitest の単体テスト。カバレッジ閾値は 90%。"
      },
      "options": {
        "command": "npx vitest run --coverage",
        "cwd": "libs/text-rules"
      }
    },
    "nx-release-publish": {
      "executor": "nx:run-commands",
      "metadata": {
        "description": "nx release の publish phase は全 group の project を回り、このターゲットを持たない project があると throw する。pecot-v に同梱するため、publish 時にすることは無い。"
      },
      "options": {
        "//forwardAllArgs-reason": "既定 true だと nx が --dryRun=true をコマンド末尾へ注入し、echo の出力にそのまま混入する。",
        "forwardAllArgs": false,
        "command": "echo 'text-rules: pecot-v に同梱するため publish は不要'"
      }
    }
  },
  "release": {
    "version": {
      "versionActions": "./.nx/nx-release/src/package-version-actions.js",
      "manifestRootsToUpdate": [
        {
          "path": "{projectRoot}"
        }
      ]
    }
  }
}
