{
  "name": "@pecot/workflow-core-src",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "pecot-workflow のコマンドと、GitHub Actions だけで動く処理が共有するコード。pecot-workflow の配布物に同梱する。",
  "type": "module",
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "exports": {
    "./*": "./dist/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/tsc.mjs --noEmit && eslint --max-warnings=0 . && knip"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "knip": {
    "entry": [
      "src/**/*.ts",
      "tests/_helpers/**/*.ts"
    ],
    "project": [
      "src/**/*.ts",
      "tests/**/*.ts"
    ],
    "ignoreDependencies": [
      "typescript7"
    ],
    "ignoreExportsUsedInFile": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.2",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-n": "^18.6.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "graphql": "^17.1.0",
    "knip": "^6.48.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.74.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^5.1.2"
  }
}
