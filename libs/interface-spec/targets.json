{
  "format": 1,
  "plugins": {
    "pecot-tools": { "entries": "complete", "coverage": "on", "sources": ["cli/src/**/*.ts"], "tests": ["cli/tests/**/*.ts", "cli/src/**/tests/**/*.ts"] },
    "pecot-visual": { "entries": "complete", "coverage": "on", "sources": ["cli/src/**/*.ts"], "tests": ["cli/tests/**/*.ts", "cli/src/**/tests/**/*.ts"] },
    "pecot-workflow": {
      "entries": "complete",
      "coverage": "on",
      "sources": [
        "cli/commands/**/*.py",
        "cli/core/**/*.py",
        "cli/__init__.py",
        "cli/__main__.py",
        "bin/*",
        "hooks/**/*.sh",
        "cli-node/src/*.ts",
        "cli-node/src/commands/*.ts",
        "cli-node/src/domain/*.ts",
        "cli-node/src/infra/*.ts",
        "cli-node/src/infra/github/*.ts",
        "cli-node/src/mcp/*.ts"
      ],
      "tests": [
        "cli/tests/**/*.py",
        "cli-node/tests/**/*.ts",
        "cli-node/src/**/tests/**/*.ts",
        "hooks/**/test_*.py"
      ]
    }
  }
}
