{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "interface-spec",
  "projectType": "library",
  "tags": [
    "type:lib",
    "scope:libs"
  ],
  "targets": {
    "install": {
      "executor": "nx:noop",
      "cache": false,
      "dependsOn": [
        {
          "projects": [
            "pecot"
          ],
          "target": "install"
        }
      ],
      "metadata": {
        "description": "依存の導入は、root の project の install（pnpm install --frozen-lockfile）が行う。このターゲットは何もせず、root の install の後に動く順序だけを lint / lint-defs / test-unit に与える。interface-spec は配布しないので runtime-lock.yaml を持たず、lock だけの更新では affected に入らない。"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "runtime",
        "env",
        "{projectRoot}/pyrightconfig.json",
        "{projectRoot}/scripts/lint-py.sh",
        "{projectRoot}/docs/pyproject.toml",
        "{projectRoot}/docs/uv.lock"
      ],
      "dependsOn": [
        "install"
      ],
      "metadata": {
        "description": "型チェック（typescript7 の tsc --noEmit）と eslint（警告も失敗）と、fixture の Python への pyright strict。"
      },
      "options": {
        "command": "pnpm run lint",
        "cwd": "libs/interface-spec"
      }
    },
    "lint-defs": {
      "executor": "nx:run-commands",
      "inputs": [
        "runtime",
        "{projectRoot}/src/**/*",
        "{projectRoot}/targets.json",
        "{projectRoot}/package.json",
        "{workspaceRoot}/plugins/*/interface/**/*",
        "{workspaceRoot}/plugins/pecot-tools/cli/src/**/*.ts",
        "{workspaceRoot}/plugins/pecot-visual/cli/src/**/*.ts",
        "{workspaceRoot}/plugins/pecot-workflow/bin/*",
        "{workspaceRoot}/plugins/pecot-workflow/hooks/**/*.sh",
        "{workspaceRoot}/plugins/pecot-workflow/cli/src/*.ts",
        "{workspaceRoot}/plugins/pecot-workflow/cli/src/commands/*.ts",
        "{workspaceRoot}/plugins/pecot-workflow/cli/src/domain/*.ts",
        "{workspaceRoot}/plugins/pecot-workflow/cli/src/infra/*.ts",
        "{workspaceRoot}/plugins/pecot-workflow/cli/src/infra/github/*.ts",
        "{workspaceRoot}/plugins/pecot-workflow/cli/src/mcp/*.ts",
        "{workspaceRoot}/libs/workflow-core/src/commands-shared/*.ts",
        "{workspaceRoot}/libs/workflow-core/src/domain/*.ts",
        "{workspaceRoot}/libs/workflow-core/src/infra/*.ts",
        "{workspaceRoot}/libs/workflow-core/src/infra/github/*.ts",
        "{workspaceRoot}/plugins/pecot-workflow/skills/w-help/references/commands.md",
        "{workspaceRoot}/plugins/pecot-tools/cli/tests/**/*.ts",
        "{workspaceRoot}/plugins/pecot-tools/cli/src/**/tests/**/*.ts",
        "{workspaceRoot}/plugins/pecot-visual/cli/tests/**/*.ts",
        "{workspaceRoot}/plugins/pecot-visual/cli/src/**/tests/**/*.ts",
        "{workspaceRoot}/plugins/pecot-workflow/cli/tests/**/*.ts",
        "{workspaceRoot}/plugins/pecot-workflow/cli/src/**/tests/**/*.ts",
        "env"
      ],
      "dependsOn": [
        "install"
      ],
      "metadata": {
        "description": "plugins/*/interface/ の定義書が形式に合うかを確かめる。定義書に無い ID を書いたテストも止める（links）。w-help の commands.md が、generated.json から作り直したものと一致するかも確かめる。失敗は 1 件 1 行で標準エラーに出す。プラグインのソース（targets.json の sources）は inputs に足してある。プラグインを足すときは、その sources の glob も足す。sources はプラグインからの相対で、../../libs/ の下の同梱するライブラリも指せる。tests の glob も inputs に足す。"
      },
      "options": {
        "command": "pnpm exec tsx src/cli.ts validate && pnpm exec tsx src/cli.ts links && pnpm exec tsx src/cli.ts commands-md --check",
        "cwd": "libs/interface-spec"
      }
    },
    "test": {
      "executor": "nx:noop",
      "cache": false,
      "dependsOn": [
        "test-unit",
        "test-site"
      ],
      "metadata": {
        "description": "CI と manual の stage の nx-affected-tests が起動するターゲット。レーン（test-*）を dependsOn で束ねる。"
      }
    },
    "test-unit": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "runtime",
        "{workspaceRoot}/plugins/pecot-workflow/cli/tests/interface-export/node-sample.json",
        "{workspaceRoot}/plugins/*/interface/generated.json",
        "{workspaceRoot}/.githooks/scripts/test_report/step-gate.mjs",
        "{workspaceRoot}/.githooks/scripts/test_report/step-gate.sh",
        "{workspaceRoot}/.githooks/scripts/run-pnpm.sh",
        "env"
      ],
      "outputs": ["{projectRoot}/test-results/test-unit/allure-results"],
      "dependsOn": [
        "install"
      ],
      "metadata": {
        "description": "vitest の単体テスト。カバレッジ閾値は 90%。pecot-workflow の書き出しの見本（cli/tests/interface-export/）を形式の検証に読むので、inputs に足してある。 tests/names.test.ts は pecot-visual・pecot-tools の定義書を材料に借りるだけなので、inputs に足さない。定義書が names に合うかは lint-defs が確かめる。 docs/tests の pytest（iface_defs 拡張）も動かす。"
      },
      "options": {
        "command": "rm -rf test-results/test-unit/allure-results && pnpm exec vitest run --coverage && uv run --locked --project docs pytest docs/tests -q --alluredir test-results/test-unit/allure-results -o pecot_report_project=interface-spec -o pecot_report_lane=test-unit && bash ../../.githooks/scripts/test_report/step-gate.sh test-results/test-unit/allure-results",
        "cwd": "libs/interface-spec"
      }
    },
    "test-site": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/docs/**/*",
        "!{projectRoot}/docs/_build/**/*",
        "!{projectRoot}/docs/.venv/**/*",
        "!{projectRoot}/docs/_generated/**/*",
        "!{projectRoot}/docs/tests/**/*",
        "{projectRoot}/tests/site/**/*",
        "{projectRoot}/vitest.site.config.ts",
        "{projectRoot}/package.json",
        "{projectRoot}/src/vitest/unique-titles.ts",
        "{projectRoot}/src/vitest/allure-reporter.ts",
        "{projectRoot}/src/vitest/attach.ts",
        "{projectRoot}/src/vitest/step.ts",
        "{workspaceRoot}/.githooks/scripts/test_report/step-gate.mjs",
        "{workspaceRoot}/.githooks/scripts/test_report/step-gate.sh",
        "{workspaceRoot}/.githooks/scripts/run-pnpm.sh",
        "{workspaceRoot}/plugins/*/interface/generated.json",
        "{workspaceRoot}/plugins/*/interface/authored.yaml",
        "{workspaceRoot}/.github/assets/**/*",
        "{workspaceRoot}/.githooks/scripts/test_report/generate.py",
        "{workspaceRoot}/.githooks/scripts/test_report/lanes.py",
        "{workspaceRoot}/.githooks/scripts/test_report/allurerc.mjs",
        "runtime",
        "env"
      ],
      "outputs": ["{projectRoot}/test-results/test-site/allure-results"],
      "dependsOn": [
        "install"
      ],
      "metadata": {
        "description": "定義書のサイトをビルドし、Chromium で全ページを開いて見た目の崩れ（目次の無いページの右の空欄・見出しの ¶・幅 390px のはみ出し）を測る。Chromium は pecot-visual と同じ playwright の版のものを使う。 report-links.test.ts は、一時の結果から test_report/generate.py でテストレポートを作る。 そのレポートを URL の tags で開き、その ID のテストだけが出ることを確かめる。"
      },
      "options": {
        "command": "rm -rf test-results/test-site/allure-results && pnpm exec vitest run --config vitest.site.config.ts && bash ../../.githooks/scripts/test_report/step-gate.sh test-results/test-site/allure-results",
        "cwd": "libs/interface-spec"
      }
    },
    "docs": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "install"
      ],
      "metadata": {
        "description": "定義書の HTML を docs/_build に作る。公開サイト（pages-build.yml）もこれで作る。PR の必須のレーンではない。 ページの上の版の知らせは、PECOT_SITE_SIDE・PECOT_SITE_PR で決まる。渡さなければ、ローカルの知らせが出る。"
      },
      "options": {
        "commands": [
          "rm -rf docs/_build",
          "mkdir -p docs/_generated",
          "uv run --locked --project docs sphinx-build -W -b html docs docs/_build"
        ],
        "parallel": false,
        "cwd": "libs/interface-spec"
      }
    }
  }
}
